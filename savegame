local function log(m) print("[save] " .. m) end

local function notify(msg, dur)
    pcall(function()
        local h = Instance.new("Hint")
        h.Text = tostring(msg)
        h.Parent = workspace
        task.delay(dur or 5, function() if h then h:Destroy() end end)
    end)
    print("[save][notify] " .. tostring(msg))
end

local function record_fail(name, class, reason)
    Stats.fail_instances = Stats.fail_instances + 1
    table.insert(Stats.fails, {
        name = tostring(name or "?"),
        class = tostring(class or "?"),
        reason = tostring(reason or "unknown"),
    })
end

-- ===== ESCAPE (bulletproof) =====
local _AMP = string.char(38)
local _AMP_E = _AMP .. "amp;"
local _AMP_Q = _AMP .. "quot;"
local _AMP_L = _AMP .. "lt;"
local _AMP_G = _AMP .. "gt;"

local function attr_escape(s)
    if s == nil then return "" end
    s = tostring(s)
    s = s:gsub(_AMP, _AMP_E)
    s = s:gsub('"', _AMP_Q)
    s = s:gsub("<", _AMP_L)
    s = s:gsub(">", _AMP_G)
    return s
end

local function cdata_escape(s)
    if s == nil then return "" end
    s = tostring(s)
    local close = "]" .. "]" .. ">"
    local fix = "]" .. "]" .. "]" .. "]" .. "><![CDATA[>"
    s = s:gsub(close, fix)
    return s
end

-- self-check
do
    local test_in = "a" .. _AMP .. "b"
    local want = "a" .. _AMP .. "amp;b"
    local got = attr_escape(test_in)
    if got ~= want then
        warn("[save] SELF-CHECK FAIL: escape corrupt, stopping")
        return
    end
    log("self-check OK")
end

-- ===== SCRIPT SOURCE =====
local function get_script_source(obj)
    local class = obj.ClassName
    if class ~= "LocalScript" and class ~= "ModuleScript" and class ~= "Script" then
        return nil, "not_script"
    end
    if CONFIG.decompile and type(decompile) == "function" then
        local ok, result = pcall(decompile, obj)
        if ok and type(result) == "string" and #result > 0 then
            Stats.decompiled = Stats.decompiled + 1
            return result, "decompiled"
        end
    end
    local ok, src = pcall(function() return obj.Source end)
    if ok and type(src) == "string" and #src > 0 then
        Stats.source_only = Stats.source_only + 1
        return src, "source"
    end
    return nil, "no_source"
end

