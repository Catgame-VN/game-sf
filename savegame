local function dump_properties(obj)
    local out = {}
    local class = obj.ClassName
    local prop_list = props_by_class[class] or {"Name"}
    for _, pname in ipairs(prop_list) do
        local ok, v = pcall(function() return obj[pname] end)
        if ok and v ~= nil then
            local t = typeof(v)
            if t == "string" then
                out[pname] = {type = "string", value = v}
            elseif t == "number" then
                out[pname] = {type = "number", value = v}
            elseif t == "boolean" then
                out[pname] = {type = "boolean", value = v}
            elseif t == "Vector3" then
                out[pname] = {type = "Vector3", value = {v.X, v.Y, v.Z}}
            elseif t == "Vector2" then
                out[pname] = {type = "Vector2", value = {v.X, v.Y}}
            elseif t == "CFrame" then
                out[pname] = {type = "CFrame", value = {v:GetComponents()}}
            elseif t == "Color3" then
                out[pname] = {type = "Color3", value = {v.R, v.G, v.B}}
            elseif t == "UDim2" then
                out[pname] = {type = "UDim2", value = {v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset}}
            elseif t == "UDim" then
                out[pname] = {type = "UDim", value = {v.Scale, v.Offset}}
            elseif t == "BrickColor" then
                out[pname] = {type = "BrickColor", value = v.Number}
            elseif t == "EnumItem" then
                out[pname] = {type = "EnumItem", value = tostring(v)}
            end
        end
    end
    return out
end

-- ===== SERIALIZE =====
local ref_counter = 0
local function next_ref()
    ref_counter = ref_counter + 1
    return string.format("RBX%032X", ref_counter)
end

local function serialize_props(obj, parts)
    table.insert(parts, '<string name="Name">' .. attr_escape(obj.Name) .. '</string>')

    local cls = obj.ClassName
    if cls == "LocalScript" or cls == "ModuleScript" or cls == "Script" then
        local src, src_type = get_script_source(obj)
        if src then
            table.insert(parts, '<ProtectedString name="Source"><![CDATA[' .. cdata_escape(src) .. ']]></ProtectedString>')
            Stats.scripts_ok = Stats.scripts_ok + 1
        else
            Stats.scripts_fail = Stats.scripts_fail + 1
            record_fail(obj:GetFullName(), cls, src_type or "no_source")
        end
    end

    local props = dump_properties(obj)
    for pname, pdata in pairs(props) do
        if pname ~= "Name" then
            local t = pdata.type
            local v = pdata.value
            if t == "string" then
                table.insert(parts, '<string name="' .. attr_escape(pname) .. '">' .. attr_escape(v) .. '</string>')
            elseif t == "number" then
                if math.floor(v) == v and math.abs(v) < 2147483647 then
                    table.insert(parts, '<int name="' .. attr_escape(pname) .. '">' .. string.format("%d", v) .. '</int>')
                else
                    table.insert(parts, '<float name="' .. attr_escape(pname) .. '">' .. string.format("%.6f", v) .. '</float>')
                end
            elseif t == "boolean" then
                table.insert(parts, '<bool name="' .. attr_escape(pname) .. '">' .. (v and "true" or "false") .. '</bool>')
            elseif t == "Vector3" then
                table.insert(parts, '<Vector3 name="' .. attr_escape(pname) .. '"><X>' .. string.format("%.4f", v[1]) .. '</X><Y>' .. string.format("%.4f", v[2]) .. '</Y><Z>' .. string.format("%.4f", v[3]) .. '</Z></Vector3>')
            elseif t == "Vector2" then
                table.insert(parts, '<Vector2 name="' .. attr_escape(pname) .. '"><X>' .. string.format("%.4f", v[1]) .. '</X><Y>' .. string.format("%.4f", v[2]) .. '</Y></Vector2>')
            elseif t == "CFrame" then
                table.insert(parts, '<CoordinateFrame name="' .. attr_escape(pname) .. '"><X>' .. string.format("%.4f", v[1]) .. '</X><Y>' .. string.format("%.4f", v[2]) .. '</Y><Z>' .. string.format("%.4f", v[3]) .. '</Z><R00>' .. string.format("%.4f", v[4]) .. '</R00><R01>' .. string.format("%.4f", v[5]) .. '</R01><R02>' .. string.format("%.4f", v[6]) .. '</R02><R10>' .. string.format("%.4f", v[7]) .. '</R10><R11>' .. string.format("%.4f", v[8]) .. '</R11><R12>' .. string.format("%.4f", v[9]) .. '</R12><R20>' .. string.format("%.4f", v[10]) .. '</R20><R21>' .. string.format("%.4f", v[11]) .. '</R21><R22>' .. string.format("%.4f", v[12]) .. '</R22></CoordinateFrame>')
            elseif t == "Color3" then
                table.insert(parts, '<Color3 name="' .. attr_escape(pname) .. '"><R>' .. string.format("%.4f", v[1]) .. '</R><G>' .. string.format("%.4f", v[2]) .. '</G><B>' .. string.format("%.4f", v[3]) .. '</B></Color3>')
            elseif t == "UDim2" then
                table.insert(parts, '<UDim2 name="' .. attr_escape(pname) .. '"><XS>' .. string.format("%.4f", v[1]) .. '</XS><XO>' .. string.format("%d", v[2]) .. '</XO><YS>' .. string.format("%.4f", v[3]) .. '</YS><YO>' .. string.format("%d", v[4]) .. '</YO></UDim2>')
            elseif t == "UDim" then
                table.insert(parts, '<UDim name="' .. attr_escape(pname) .. '"><S>' .. string.format("%.4f", v[1]) .. '</S><O>' .. string.format("%d", v[2]) .. '</O></UDim>')
            elseif t == "BrickColor" then
                table.insert(parts, '<int name="' .. attr_escape(pname) .. '">' .. string.format("%d", v) .. '</int>')
            elseif t == "EnumItem" then
                local enum_str = tostring(v)
                local parts_e = {}
                for s in enum_str:gmatch("[^%.]+") do table.insert(parts_e, s) end
                if #parts_e == 3 then
                    local enum_value = 0
                    pcall(function()
                        local et = Enum[parts_e[2]]
                        if et then
                            local item = et[parts_e[3]]
                            if item then enum_value = item.Value end
                        end
                    end)
                    table.insert(parts, '<token name="' .. attr_escape(pname) .. '">' .. string.format("%d", enum_value) .. '</token>')
                end
            end
        end
    end
end

local function serialize_instance(obj, depth, visited, parts)
    if depth > CONFIG.max_depth then
        record_fail(obj:GetFullName(), obj.ClassName, "max_depth")
        return
    end
    if visited[obj] then return end
    visited[obj] = true

    local class = obj.ClassName
    if CONFIG.ignore_classes[class] then return end
    if CONFIG.ignore_names[obj.Name] then return end

    local ref = next_ref()
    local start_len = #parts

    local ok, err = pcall(function()
        table.insert(parts, '<Item class="' .. attr_escape(class) .. '" referent="' .. ref .. '">')
        table.insert(parts, "<Properties>")
        serialize_props(obj, parts)
        table.insert(parts, "</Properties>")
    end)

    if not ok then
        for i = #parts, start_len + 1, -1 do parts[i] = nil end
        record_fail(obj:GetFullName(), class, "props_error: " .. tostring(err))
        return
    end

    Stats.ok_instances = Stats.ok_instances + 1
    if class == "Model" or class == "MeshPart" or class == "Part" or class == "WedgePart" then
        Stats.models_ok = Stats.models_ok + 1
    end

    local children_ok, children = pcall(function() return obj:GetChildren() end)
    if children_ok and children then
        for _, child in ipairs(children) do
            local child_ok, child_err = pcall(function()
                serialize_instance(child, depth + 1, visited, parts)
            end)
            if not child_ok then
                record_fail(child:GetFullName(), child.ClassName, "child_error: " .. tostring(child_err))
            end
        end
    end

    table.insert(parts, "</Item>")
end

-- ===== ROOTS =====
local function get_roots()
    local roots = {}
    if CONFIG.save_workspace then pcall(function() table.insert(roots, workspace) end) end
    if CONFIG.save_replicatedstorage then pcall(function() table.insert(roots, game:GetService("ReplicatedStorage")) end) end
    if CONFIG.save_replicatedfirst then pcall(function() table.insert(roots, game:GetService("ReplicatedFirst")) end) end
    if CONFIG.save_startergui then pcall(function() table.insert(roots, game:GetService("StarterGui")) end) end
    if CONFIG.save_starterpack then pcall(function() table.insert(roots, game:GetService("StarterPack")) end) end
    if CONFIG.save_playergui then pcall(function()
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then table.insert(roots, pg) end
    end) end
    if CONFIG.save_lighting then pcall(function() table.insert(roots, game:GetService("Lighting")) end) end
    return roots
end

-- ===== BUILD =====
local function build_xml()
    local parts = {}
    table.insert(parts, '<?xml version="1.0" encoding="utf-8"?>')
    table.insert(parts, '<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">')
    table.insert(parts, "<External>null</External>")
    table.insert(parts, "<External>nil</External>")

    local roots = get_roots()
    local visited = {}

    for i, root in ipairs(roots) do
        log(("root [%d/%d] %s (%s)"):format(i, #roots, root.Name, root.ClassName))
        local ok, err = pcall(function()
            serialize_instance(root, 0, visited, parts)
        end)
        if not ok then
            record_fail(root.Name, root.ClassName, "root_error: " .. tostring(err))
        end
    end

    table.insert(parts, "</roblox>")
    return table.concat(parts, "\n")
end

-- ===== REPORT =====
local function build_report()
    local lines = {}
    table.insert(lines, "=== saveinstance report ===")
    table.insert(lines, "time: " .. os.date("%Y-%m-%d %H:%M:%S"))
    table.insert(lines, "ok_instances: " .. Stats.ok_instances)
    table.insert(lines, "fail_instances: " .. Stats.fail_instances)
    table.insert(lines, "models_ok: " .. Stats.models_ok)
    table.insert(lines, "scripts_ok: " .. Stats.scripts_ok)
    table.insert(lines, "scripts_fail: " .. Stats.scripts_fail)
    table.insert(lines, "decompiled: " .. Stats.decompiled)
    table.insert(lines, "source_only: " .. Stats.source_only)
    table.insert(lines, "")
    table.insert(lines, "=== fails ===")
    if #Stats.fails == 0 then
        table.insert(lines, "(none)")
    else
        for i, f in ipairs(Stats.fails) do
            table.insert(lines, ("[%d] %s | %s | %s"):format(i, f.name, f.class, f.reason))
        end
    end
    return table.concat(lines, "\n")
end

-- ===== SAVE =====
local function save()
    local start = tick()
    log("building xml...")

    local ok, xml = pcall(build_xml)
    if not ok then
        log("FATAL build error: " .. tostring(xml))
        notify("save failed: " .. tostring(xml), 8)
        return
    end

    if not xml or #xml == 0 then
        log("empty xml")
        notify("empty xml", 5)
        return
    end

    local mb = #xml / 1024 / 1024
    log(("xml built: %.2f MB in %.1fs"):format(mb, tick() - start))

    local wrote_primary = false
    if type(writefile) == "function" then
        local wok, werr = pcall(writefile, CONFIG.output_file, xml)
        if wok then
            wrote_primary = true
            log("SAVED: " .. CONFIG.output_file)
        else
            log("WRITE FAIL: " .. tostring(werr))
            record_fail(CONFIG.output_file, "file", "write_error: " .. tostring(werr))
        end
    else
        log("writefile unavailable")
    end

    if wrote_primary and type(writefile) == "function" then
        pcall(function()
            writefile("/sdcard/" .. CONFIG.output_file, xml)
            log("ALSO SAVED: /sdcard/" .. CONFIG.output_file)
        end)
    end

    if not wrote_primary and #xml < 500 * 1024 and type(setclipboard) == "function" then
        pcall(setclipboard, xml)
        log("copied to clipboard (" .. math.floor(#xml / 1024) .. "KB)")
    end

    local report = build_report()
    print(report)
    if type(writefile) == "function" then
        pcall(writefile, CONFIG.report_file, report)
        pcall(function() writefile("/sdcard/" .. CONFIG.report_file, report) end)
        log("report: " .. CONFIG.report_file)
    end

    local summary = ("done: ok=%d fail=%d script_ok=%d script_fail=%d"):format(
        Stats.ok_instances, Stats.fail_instances,
        Stats.scripts_ok, Stats.scripts_fail
    )
    log(summary)
    notify(summary, 8)
end

-- ===== ENTRY =====
log("=== saveinstance v3 ===")
log("writefile: " .. tostring(type(writefile) == "function"))
log("decompile: " .. tostring(type(decompile) == "function"))

if type(saveinstance) == "function" then
    log("native saveinstance available")
    local ok, err = pcall(saveinstance, CONFIG.output_file)
    if ok then
        notify("native saveinstance OK", 5)
    else
        log("native failed: " .. tostring(err) .. ", fallback xml")
        save()
    end
else
    save()
end
