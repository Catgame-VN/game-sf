local LP = Players.LocalPlayer

local CONFIG = {
    output_file = "game_save.rbxlx",
    report_file = "save_report.txt",
    max_depth = 30,
    decompile = true,
    save_workspace = true,
    save_replicatedstorage = true,
    save_startergui = true,
    save_starterpack = true,
    save_replicatedfirst = true,
    save_playergui = true,
    save_lighting = false,   -- bật nếu cần
    ignore_classes = {
        ["Player"] = true,
        ["Players"] = true,
        ["Camera"] = true,
        ["Terrain"] = true,   -- terrain nặng, tắt mặc định
    },
    ignore_names = {
        ["Chat"] = true,
        ["RobloxLoadingScreen"] = true,
        ["TouchGui"] = true,
        ["DevConsole"] = true,
        ["CoreGui"] = true,
