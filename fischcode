                            lastBite = tick()
                            task.spawn(reel_now)
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

-- admin
local function is_admin_player(plr)
    if plr == LP then return false end
    local name = plr.Name:lower()
    local disp = (plr.DisplayName or ""):lower()
    for _, kw in ipairs(CONFIG.admin_keywords) do
        if name:find(kw, 1, true) or disp:find(kw, 1, true) then
            return true, "name:" .. kw
        end
    end
    local char = plr.Character
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local tn = tool.Name:lower()
                for _, kw in ipairs({"admin", "ban", "kick", "command"}) do
                    if tn:find(kw, 1, true) then return true, "tool:" .. kw end
                end
            end
        end
    end
    local ok, age = pcall(function() return plr.AccountAge end)
    if ok and type(age) == "number" and age > CONFIG.admin_age_threshold then
        return true, "age:" .. age
    end
    return false, ""
end

task.spawn(function()
    if not CONFIG.admin_detect then return end
    while true do
        for _, plr in ipairs(Players:GetPlayers()) do
            local isAdm, reason = is_admin_player(plr)
            if isAdm then
                adminFound = true
                adminName = plr.Name .. " (" .. reason .. ")"
                running = false
                autoEvent = false
                log("=== ADMIN: " .. adminName .. " ===")
                pcall(function()
                    local hint = Instance.new("Hint")
                    hint.Text = "ADMIN DETECTED: " .. adminName .. " - stopped"
                    hint.Parent = workspace
                    task.delay(10, function() if hint then hint:Destroy() end end)
                end)
                break
            end
        end
        task.wait(CONFIG.admin_scan_interval)
    end
end)

-- rarity/sell
local function get_fish_list()
    local list = {}
    for _, g in ipairs(PG:GetDescendants()) do
        if g:IsA("TextLabel") and g.Visible then
            local t = g.Text:lower()
            local rar = nil
            if t:find("legendary") then rar = "legendary"
            elseif t:find("mythic") then rar = "mythic"
            elseif t:find("exotic") then rar = "exotic"
            elseif t:find("limited") then rar = "limited"
            elseif t:find("event") then rar = "event"
            elseif t:find("rare") then rar = "rare"
            elseif t:find("uncommon") then rar = "uncommon"
            elseif t:find("common") then rar = "common" end
            if rar then
                table.insert(list, {label = g, rarity = rar, parent = g.Parent})
            end
        end
    end
    return list
end

local function do_sell(mode)
    if not sellRemote then log("sell nil"); return end
    if mode == "all" then
        pcall(function()
            if sellRemote:IsA("RemoteEvent") then sellRemote:FireServer("all")
            else sellRemote:InvokeServer("all") end
        end)
        stats.sold = stats.sold + caught_since
        caught_since = 0
        log("sold ALL")
        return
    end
    local fish = get_fish_list()
    local to_sell = {}
    for _, f in ipairs(fish) do
        if not CONFIG.keep_rarity[f.rarity] then table.insert(to_sell, f) end
    end
    for _, f in ipairs(to_sell) do
        pcall(function()
            if sellRemote:IsA("RemoteEvent") then
                sellRemote:FireServer(f.rarity, f.parent and f.parent.Name or nil)
            else
                sellRemote:InvokeServer(f.rarity, f.parent and f.parent.Name or nil)
            end
        end)
        stats.sold = stats.sold + 1
        task.wait(0.1)
    end
    caught_since = 0
    log("sold filtered")
end

-- teleport
local function teleport_to(vec)
    if not vec then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = CFrame.new(vec + Vector3.new(0, CONFIG.teleport_y_offset, 0))
    task.wait(0.4)
    hrp.CFrame = CFrame.new(vec + Vector3.new(0, CONFIG.teleport_y_offset, 0))
    log("tp -> " .. tostring(vec))
end

local function save_pos(name)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    ISLANDS[name] = hrp.Position
    save_islands()
    log(("saved %s"):format(name))
end

local function save_event_pos()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    eventPos = hrp.Position
    save_event()
    log(("saved event = %s"):format(tostring(eventPos)))
end

-- event detect
local function detect_event()
    for _, g in ipairs(PG:GetDescendants()) do
        if g:IsA("TextLabel") and g.Visible then
            local t = g.Text:lower()
            for _, kw in ipairs(CONFIG.event_keywords) do
                if t:find(kw, 1, true) then return true end
            end
        end
    end
    return false
end

task.spawn(function()
    while true do
        if autoEvent and running and eventPos and not adminFound then
            lastEventDetect = detect_event()
            if lastEventDetect and tick() - lastEventTP > CONFIG.event_tp_cooldown then
                teleport_to(eventPos)
                lastEventTP = tick()
                log("event tp")
            end
        end
        task.wait(CONFIG.event_scan_interval)
    end
end)

-- main loop
local function main()
    while true do
        if not running then task.wait(0.5) continue end
        if CONFIG.admin_detect and adminFound then running = false continue end

        local rod = get_equipped_rod()
        if not rod then
            rod = equip_any_rod()
            if not rod then task.wait(1.0) continue end
        end

        do_cast()

        local t0 = tick()
        while tick() - t0 < CONFIG.bite_timeout do
            if not running then break end
            if tick() - lastBite < 0.5 then break end
            task.wait(0.1)
        end

        if running and tick() - lastBite < 1.5 then
            stats.caught = stats.caught + 1
            caught_since = caught_since + 1
            if CONFIG.auto_sell and caught_since >= CONFIG.sell_every then
                task.spawn(do_sell, "filtered")
            end
        end

        task.wait(0.5 + math.random() * 0.4)
    end
end

