-- rod
local function get_equipped_rod()
    local c = LP.Character
    if not c then return nil end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find("rod") then return t end
    end
    return nil
end
local function equip_any_rod()
    local c = LP.Character
    if not c then return nil end
    local bp = LP:FindFirstChild("Backpack")
    if not bp then return nil end
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find("rod") then
            t.Parent = c
            task.wait(0.35)
            return t
        end
    end
    return nil
end

-- cast meter
local function find_cast_meter()
    for _, g in ipairs(PG:GetDescendants()) do
        if g:IsA("Frame") and g.Visible and g.Size.X.Scale > 0.01 and g.Size.X.Scale < 1.01 then
            local n = g.Name:lower()
            if (n:find("power") or n:find("cast") or n:find("charge")
                or n:find("fill") or n:find("meter"))
                and not n:find("background") and not n:find("frame") then
                return g
            end
        end
    end
    return nil
end

local function do_cast()
    if not running then return false end
    if CONFIG.admin_detect and adminFound then return false end

    local rod = get_equipped_rod()
    if not rod then
        rod = equip_any_rod()
        if not rod then return false end
    end

    hold_start()
    local meter, t0 = nil, tick()
    while tick() - t0 < 0.2 do
        task.wait(0.03)
        meter = find_cast_meter()
        if meter then break end
    end

    if meter and CONFIG.perfect_cast then
        local t1 = tick()
        while tick() - t1 < 3 do
            task.wait(0.02)
            if not meter or not meter.Parent then break end
            castFill = meter.Size.X.Scale
            if castFill >= CONFIG.perfect_threshold then break end
        end
    else
        task.wait(CONFIG.cast_hold)
        castFill = 1.0
    end

    hold_stop()
    task.wait(0.15)
    for _ = 1, CONFIG.shake_count do
        key_space()
        task.wait(CONFIG.shake_delay)
    end
    return true
end

-- reel
local function reel_now()
    if not running then return end
    if CONFIG.admin_detect and adminFound then return end
    if not CONFIG.auto_reel then return end
    if reelRemote then
        pcall(function()
            if reelRemote:IsA("RemoteEvent") then reelRemote:FireServer()
            else reelRemote:InvokeServer(true) end
        end)
        task.wait(0.15)
        return
    end
    for _ = 1, CONFIG.reel_spam_count do
        tap()
        task.wait(CONFIG.reel_spam_delay)
    end
end

if reelRemote and reelRemote:IsA("RemoteEvent") then
    reelRemote.OnClientEvent:Connect(function()
        lastBite = tick()
        task.spawn(reel_now)
    end)
end

task.spawn(function()
