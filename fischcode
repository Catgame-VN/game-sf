end

local function uiOk(t) uiLog("OK   " .. t, Color3.fromRGB(100, 220, 100)) end
local function uiFail(t) uiLog("FAIL " .. t, Color3.fromRGB(220, 100, 100)) end
local function uiInfo(t) uiLog("INFO " .. t, Color3.fromRGB(100, 180, 220)) end
local function uiWarn(t) uiLog("WARN " .. t, Color3.fromRGB(220, 200, 100)) end

