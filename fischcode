local function mkBtn(txt, x, w, color)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(w, -4, 1, 0)
    b.Position = UDim2.new(x, 2, 0, 0)
    b.BackgroundColor3 = color
    b.Text = txt
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.Parent = btnRow
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = b
    return b
end

-- TEST CAST button
local btnCast = mkBtn("TEST CAST", 0, 0.33, Color3.fromRGB(50, 140, 90))
btnCast.MouseButton1Click:Connect(function()
    uiInfo("--- TEST CAST ---")
    if not functions_ok.mouse1down then
        uiFail("mouse1down missing, không cast được")
        return
    end

    uiInfo("hold_start...")
    pcall(mouse1down)
    task.wait(0.3)

    -- scan meter trong 1s
    for i = 1, 20 do
        local m = find_meters()
        if #m > 0 then
            local m0 = m[1]
            uiInfo(("meter: %s x=%.2f"):format(m0.name, m0.size.X.Scale))
        end
        task.wait(0.05)
    end

    uiInfo("hold_stop")
    if functions_ok.mouse1up then pcall(mouse1up) end

    task.wait(0.5)
    uiOk("cast test done — nhìn screen có cast không?")
end)

-- RESCAN button
local btnRescan = mkBtn("RESCAN", 0.33, 0.34, Color3.fromRGB(50, 100, 160))
btnRescan.MouseButton1Click:Connect(function()
    uiInfo("--- RESCAN METERS ---")
    local m = find_meters()
    if #m == 0 then
        uiWarn("vẫn không thấy meter. cast đang ở giữa chừng?")
    else
