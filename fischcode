-- ===== 2. ROD CHECK =====
sep()
uiInfo("=== 2. ROD ===")

local function get_rod()
    local c = LP.Character
    if not c then return nil end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local n = t.Name:lower()
            if n:find("rod") or n:find("cần") or n:find("can") then
                return t
            end
        end
    end
    return nil
end

local rod = get_rod()
if rod then
    uiOk("equipped: " .. rod.Name)
else
    uiFail("no rod equipped")
    uiInfo("tools in character:")
    if LP.Character then
        for _, t in ipairs(LP.Character:GetChildren()) do
            if t:IsA("Tool") then uiInfo("  -> " .. t.Name) end
        end
    end
end

-- ===== 3. REMOTE DUMP =====
sep()
uiInfo("=== 3. REMOTES ===")

local remotes = {}
for _, o in ipairs(RS:GetDescendants()) do
    if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
        table.insert(remotes, o)
    end
end

uiInfo("total remotes: " .. #remotes)

for _, r in ipairs(remotes) do
    local n = r.Name:lower()
    local tag = "      "
    if n:find("cast") or n:find("fishing") or n:find("fish") then
        tag = "[CAST]"
    elseif n:find("reel") or n:find("catch") then
        tag = "[REEL]"
    elseif n:find("sell") then
        tag = "[SELL]"
    elseif n:find("bite") then
        tag = "[BITE]"
    end
    if tag ~= "      " then
        uiOk(tag .. " " .. r.Name .. " (" .. r.ClassName .. ")")
    end
end

uiInfo("--- all remotes ---")
for _, r in ipairs(remotes) do
    uiLog("  " .. r.Name .. " [" .. r.ClassName .. "]", Color3.fromRGB(150, 150, 150))
end

-- ===== 4. CAST METER SEARCH =====
sep()
uiInfo("=== 4. CAST METER ===")

local function find_meters()
    local found = {}
    for _, g in ipairs(PG:GetDescendants()) do
        if g:IsA("Frame") and g.Visible then
            local n = g.Name:lower()
            if n:find("power") or n:find("cast") or n:find("charge")
               or n:find("meter") or n:find("bar") or n:find("fill") then
                table.insert(found, {
                    obj = g,
                    name = g.Name,
                    size = g.Size,
                    parent = g.Parent and g.Parent.Name or "?",
                })
            end
        end
    end
    return found
end

local meters = find_meters()
if #meters > 0 then
    uiOk("found " .. #meters .. " potential meter(s)")
    for _, m in ipairs(meters) do
        uiInfo(("  %s (parent:%s, x-scale:%.2f)"):format(
            m.name, m.parent, m.size.X.Scale
        ))
    end
else
    uiWarn("no meter found — hold cast rồi bấm REFRESH để scan lại")
end

-- ===== 5. UI SCAN (event hints) =====
sep()
uiInfo("=== 5. UI SCAN ===")

local function scan_ui_keywords()
    local hits = {}
    for _, g in ipairs(PG:GetDescendants()) do
        if g:IsA("TextLabel") and g.Visible then
            local t = g.Text:lower()
            if t:find("bite") or t == "!" then
                table.insert(hits, "BITE: " .. g.Text)
            elseif t:find("press") or t:find("click") or t:find("hold") then
                table.insert(hits, "ACTION: " .. g.Text)
            end
        end
    end
    return hits
end

local hits = scan_ui_keywords()
if #hits > 0 then
    for _, h in ipairs(hits) do uiInfo(h) end
else
    uiInfo("no bite/action hints (chưa cast hoặc UI dùng ảnh)")
end

