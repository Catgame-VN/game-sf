            uiInfo(("  %s x=%.2f parent=%s"):format(
                mm.name, mm.size.X.Scale, mm.parent
            ))
        end
    end
end)

-- LOGGING toggle
local logging = false
local btnLog = mkBtn("LOG: OFF", 0.67, 0.33, Color3.fromRGB(100, 60, 160))
btnLog.MouseButton1Click:Connect(function()
    logging = not logging
    btnLog.Text = "LOG: " .. (logging and "ON" or "OFF")
    btnLog.BackgroundColor3 = logging
        and Color3.fromRGB(180, 100, 30)
        or Color3.fromRGB(100, 60, 160)
    if logging then
        uiOk("logging all remote traffic...")
        for _, r in ipairs(RS:GetDescendants()) do
            if r:IsA("RemoteEvent") then
                r.OnClientEvent:Connect(function(...)
                    local args = {...}
                    local argStr = ""
                    for i, v in ipairs(args) do
                        if i > 3 then break end
                        argStr = argStr .. tostring(v) .. " "
                    end
                    print(("[EVT] %s <- %s"):format(r.Name, argStr))
                end)
            end
        end
        uiInfo("hook set. fire cast → xem console (không phải UI)")
    end
end)

