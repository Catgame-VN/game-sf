-- ===== ADMIN DETECT =====
local function is_admin_player(plr)
    if plr == LP then return false end

    local name = plr.Name:lower()
    local display = (plr.DisplayName or ""):lower()

    for _, kw in ipairs(CONFIG.admin_keywords) do
        if name:find(kw, 1, true) or display:find(kw, 1, true) then
            return true, "name:" .. kw
        end
    end

    local char = plr.Character
    if char then
        local head = char:FindFirstChild("Head")
        if head then
            for _, tag in ipairs(head:GetChildren()) do
                if tag:IsA("BillboardGui") or tag:IsA("TextLabel") then
                    local txt = (tag.Text or ""):lower()
                    for _, kw in ipairs(CONFIG.admin_keywords) do
                        if txt:find(kw, 1, true) then
                            return true, "tag:" .. kw
                        end
                    end
                end
            end
        end
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local tn = tool.Name:lower()
                for _, kw in ipairs({"admin", "ban", "kick", "command", "console"}) do
                    if tn:find(kw, 1, true) then
                        return true, "tool:" .. kw
                    end
                end
            end
        end
    end

    local ok, age = pcall(function() return plr.AccountAge end)
    if ok and type(age) == "number" and age > CONFIG.admin_age_threshold then
        return true, "age:" .. age
    end

    return false, ""
end

local function scan_admins()
    for _, plr in ipairs(Players:GetPlayers()) do
        local isAdm, reason = is_admin_player(plr)
        if isAdm then
            adminFound = true
            adminName = plr.Name .. " (" .. reason .. ")"
            return true
        end
    end
    return false
end

-- ===== RARITY DETECT =====
local function get_fish_list()
    local list = {}
    if not PG then return list end
    for _, g in ipairs(PG:GetDescendants()) do
        if g:IsA("TextLabel") and g.Visible then
            local t = g.Text:lower()
            local rar = nil
            if t:find("legendary") then rar = "legendary"
            elseif t:find("mythic") then rar = "mythic"
            elseif t:find("exotic") then rar = "exotic"
            elseif t:find("limited") then rar = "limited"
            elseif t:find("event") then rar = "event"
            elseif t:find("rare") then rar = "rare"
            elseif t:find("uncommon") then rar = "uncommon"
            elseif t:find("common") then rar = "common"
            end
            if rar then
                table.insert(list, {
                    label = g,
                    rarity = rar,
                    parent = g.Parent,
                })
            end
        end
    end
    return list
end

-- ===== SELL =====
local function do_sell(mode)
    if CONFIG.admin_detect and adminFound then return end
    if not sellRemote then
        log("sell remote nil")
        return
    end

    if mode == "all" then
        pcall(function()
            if sellRemote:IsA("RemoteEvent") then
                sellRemote:FireServer("all")
            else
                sellRemote:InvokeServer("all")
            end
        end)
        stats.sold = stats.sold + caught_since
        caught_since = 0
        log("sold ALL")
        return
    end

    local fish = get_fish_list()
    local to_sell = {}
    local to_keep = {}
    for _, f in ipairs(fish) do
        if CONFIG.keep_rarity[f.rarity] then
            table.insert(to_keep, f)
        else
            table.insert(to_sell, f)
        end
    end

    log(("filtered: sell %d keep %d"):format(#to_sell, #to_keep))
    stats.kept = stats.kept + #to_keep

    for _, f in ipairs(to_sell) do
        pcall(function()
            if sellRemote:IsA("RemoteEvent") then
                sellRemote:FireServer(f.rarity, f.parent and f.parent.Name or nil)
            else
                sellRemote:InvokeServer(f.rarity, f.parent and f.parent.Name or nil)
            end
        end)
        stats.sold = stats.sold + 1
        task.wait(0.1)
    end
    caught_since = 0
    log("sold filtered (" .. stats.sold .. ")")
end

-- ===== TELEPORT =====
local function teleport_to(vec)
    if not vec then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    hrp.CFrame = CFrame.new(vec + Vector3.new(0, CONFIG.teleport_y_offset, 0))
    task.wait(0.5)
    hrp.CFrame = CFrame.new(vec + Vector3.new(0, CONFIG.teleport_y_offset, 0))
    log("teleported -> " .. tostring(vec))
end

local function save_current_pos(name)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    ISLANDS[name] = hrp.Position
    log(("saved %s = %s"):format(name, tostring(hrp.Position)))
end

-- ===== ADMIN SHUTDOWN =====
local function trigger_shutdown()
    running = false
    pcall(function()
        for _, gui in ipairs(PG:GetChildren()) do
            if gui.Name == "FischAutoV3" then
                gui.Enabled = false
            end
        end
    end)
    pcall(function()
        local hint = Instance.new("Hint")
        hint.Text = "⚠ ADMIN DETECTED: " .. adminName .. " — hack stopped ⚠"
        hint.Parent = workspace
        task.delay(10, function()
            if hint then hint:Destroy() end
        end)
    end)
    log("=== ADMIN DETECTED: " .. adminName .. " ===")
end

task.spawn(function()
    if not CONFIG.admin_detect then return end
    while running do
        if scan_admins() then
            trigger_shutdown()
            break
        end
        task.wait(CONFIG.admin_scan_interval)
    end
end)

-- ===== MAIN LOOP =====
local function main()
    while running do
        if CONFIG.admin_detect and adminFound then break end
        do_cast()

        local t0 = tick()
        while tick() - t0 < CONFIG.bite_timeout do
            if tick() - lastBite < 0.5 then break end
            if adminFound then return end
            task.wait(0.1)
        end

        if tick() - lastBite < 1.5 then
            stats.caught = stats.caught + 1
            caught_since = caught_since + 1
            log(("caught #%d"):format(stats.caught))
            if CONFIG.auto_sell and caught_since >= CONFIG.sell_every then
                task.spawn(do_sell, "filtered")
            end
        else
            log("no bite, recast")
        end

        task.wait(0.6 + math.random() * 0.4)
    end
end

