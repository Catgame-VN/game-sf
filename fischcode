local function find_remote(pats)
    for _, o in ipairs(RS:GetDescendants()) do
        if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
            local n = o.Name:lower()
            for _, p in ipairs(pats) do
                if n:find(p, 1, true) then return o end
            end
        end
    end
    return nil
end

