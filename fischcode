-- persistence
local function load_data()
    if not readfile or not isfile then return end
    pcall(function()
        if isfile(ISLAND_FILE) then
            local d = HttpS:JSONDecode(readfile(ISLAND_FILE))
            for name, c in pairs(d) do
                if type(c) == "table" and c[1] then
                    ISLANDS[name] = Vector3.new(c[1], c[2], c[3])
                end
            end
        end
    end)
end
local function save_islands()
    if not writefile then return end
    pcall(function()
        local out = {}
        for name, v in pairs(ISLANDS) do
            if v then out[name] = {v.X, v.Y, v.Z} end
        end
        writefile(ISLAND_FILE, HttpS:JSONEncode(out))
    end)
end

local eventPos = nil
local function load_event()
    if not readfile or not isfile then return end
    pcall(function()
        if isfile(EVENT_FILE) then
            local d = HttpS:JSONDecode(readfile(EVENT_FILE))
            if d and d[1] then
                eventPos = Vector3.new(d[1], d[2], d[3])
            end
        end
    end)
end
local function save_event()
    if not writefile then return end
    pcall(function()
        if eventPos then
            writefile(EVENT_FILE, HttpS:JSONEncode({eventPos.X, eventPos.Y, eventPos.Z}))
        end
    end)
end

