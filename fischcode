-- ===== CAST =====
local function do_cast()
    if CONFIG.admin_detect and adminFound then return false end
    local char = LP.Character
    if not char then return false end

    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        local bp = LP:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("rod") then
                    t.Parent = char
                    task.wait(0.3)
                    tool = t
                    break
                end
            end
        end
    end
    if not tool then
        log("no rod equipped")
        return false
    end

    hold_start()
    task.wait(CONFIG.cast_hold)
    hold_stop()
    task.wait(0.3)

    for _ = 1, CONFIG.shake_count do
        key_space()
        task.wait(CONFIG.shake_delay)
    end
    return true
end

-- ===== AUTO REEL =====
local function reel_now()
    if CONFIG.admin_detect and adminFound then return end
    if not CONFIG.auto_reel then return end

    if reelRemote then
        pcall(function()
            if reelRemote:IsA("RemoteEvent") then
                reelRemote:FireServer()
            else
                reelRemote:InvokeServer(true)
            end
        end)
        task.wait(0.15)
        return
    end

    for _ = 1, CONFIG.reel_spam_count do
        tap()
        task.wait(CONFIG.reel_spam_delay)
    end
end

