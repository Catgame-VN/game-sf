local function rebuild_tp()
    for _, ch in ipairs(tpScroll:GetChildren()) do
        if ch:IsA("TextButton") or ch:IsA("Frame") then ch:Destroy() end
    end

    local names = {}
    for n, _ in pairs(ISLANDS) do table.insert(names, n) end
    table.sort(names)

    for _, name in ipairs(names) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 48)
        row.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
        row.BorderSizePixel = 0
        row.Parent = tpScroll
        mkCorner(row)

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -140, 1, 0)
        lbl.Position = UDim2.new(0, 12, 0, 0)
        lbl.BackgroundTransparency = 1
        local hasPos = ISLANDS[name] ~= nil
        lbl.Text = (hasPos and "✅ " or "⚠  ") .. name
        lbl.TextColor3 = hasPos and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 180, 120)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = row

        local btnGO = Instance.new("TextButton")
        btnGO.Size = UDim2.new(0, 58, 0, 36)
        btnGO.Position = UDim2.new(1, -132, 0, 6)
        btnGO.BackgroundColor3 = hasPos and Color3.fromRGB(45, 100, 160) or Color3.fromRGB(60, 60, 60)
        btnGO.Text = "GO"
        btnGO.TextColor3 = Color3.fromRGB(255, 255, 255)
        btnGO.Font = Enum.Font.GothamBold
        btnGO.TextSize = 13
        btnGO.Parent = row
        mkCorner(btnGO, 6)

        local btnSET = Instance.new("TextButton")
        btnSET.Size = UDim2.new(0, 58, 0, 36)
        btnSET.Position = UDim2.new(1, -66, 0, 6)
        btnSET.BackgroundColor3 = Color3.fromRGB(50, 140, 90)
        btnSET.Text = "SET"
        btnSET.TextColor3 = Color3.fromRGB(255, 255, 255)
        btnSET.Font = Enum.Font.GothamBold
        btnSET.TextSize = 13
        btnSET.Parent = row
        mkCorner(btnSET, 6)

        btnGO.MouseButton1Click:Connect(function()
            if ISLANDS[name] then
                teleport_to(ISLANDS[name])
            else
                local h = Instance.new("Hint")
                h.Text = name .. " chưa save pos. Đứng ở đó, bấm SET."
                h.Parent = workspace
                task.delay(3, function() if h then h:Destroy() end end)
            end
        end)

        btnSET.MouseButton1Click:Connect(function()
            save_pos(name)
            rebuild_tp()
        end)
    end
end
