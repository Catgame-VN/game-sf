local function update_scale()
    local vp = CAM and CAM.ViewportSize or Vector2.new(800, 600)
    -- thiết kế gốc cho 400x800 px (mobile portrait)
    -- scale = min(vp/400, vp/800) để fit cả hai chiều
    local s = math.min(vp.X / 400, vp.Y / 800)
    s = math.clamp(s, 0.6, 1.4)
    scale.Scale = s
end
update_scale()
if CAM then
    CAM:GetPropertyChangedSignal("ViewportSize"):Connect(update_scale)
end

