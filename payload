local function getOwnedTool(name)
    for _, parent in ipairs({Backpack, Me.Character}) do
        for _, o in ipairs(parent:GetChildren()) do
            if o:IsA("Tool") and o.Name == name then return o end
        end
    end
end
local function getSlotByToolName(name)
    for i, def in ipairs(Slots) do if def.Name == name and name ~= "" then return i end end
end
local function definition(tool)
    local i = tool and getSlotByToolName(tool.Name)
    return i, i and Slots[i] or FALLBACK
end
local function targetYAllowed(player)
    local _,root=alive(player)
    local _,reference=alive(SelectedPlayer)
    if not root or not reference then return false end
    local last=TargetY[root]
    TargetY[root]=root.Position.Y
    if last and math.abs(root.Position.Y-last)>CONFIG.MaxTargetY then BlockedY[root]=true end
    if BlockedY[root] then return false end
    return math.abs(root.Position.Y-reference.Position.Y)<=CONFIG.MaxTargetY
end
local function eligible(player)
    if player == Me or not alive(player) then return false end
    if CONFIG.Friendly[tostring(player.UserId)] then return false end
    if not targetYAllowed(player) then return false end
    if CONFIG.Mode == "ELIMINATE" then return player == SelectedPlayer end
    return player ~= SelectedPlayer
end
local function selectSkillTarget(radius)
    if CONFIG.Mode == "ELIMINATE" then
        return eligible(SelectedPlayer) and SelectedPlayer or nil
    end
    local _, center = alive(SelectedPlayer)
    if not center then return nil end
    local best, result = radius, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if eligible(p) then
            local _, root = alive(p)
            local d = (root.Position-center.Position).Magnitude
            if d <= best then best, result = d, p end
        end
    end
    return result
end
local function releaseOwnCharacter()
    removeFlight()
    resetFollowPose()
    if FootPad then FootPad:Destroy(); FootPad=nil end
    if IdleTrack then IdleTrack:Stop(0.08); IdleTrack:Destroy(); IdleTrack=nil end
    if ManagedHum and ManagedHum.Parent and StateSaved~=nil then
        ManagedHum:SetStateEnabled(Enum.HumanoidStateType.Freefall,StateSaved)
    end
    StateSaved=nil
    NextIdleCheck=0
    if PartConnection then PartConnection:Disconnect(); PartConnection=nil end
    if HealthConnection then HealthConnection:Disconnect(); HealthConnection=nil end
    if ManagedHum and ManagedHum.Parent and SavedMotion then
        for k, v in pairs(SavedMotion) do ManagedHum[k] = v end
    end
    for part, value in pairs(SavedCollisions) do
        if part.Parent then part.CanCollide = value end
    end
    SavedCollisions = {}
    ManagedChar, ManagedHum, SavedMotion = nil, nil, nil
end
local function savePart(o)
    if o:IsA("BasePart") then
        if SavedCollisions[o] == nil then SavedCollisions[o] = o.CanCollide end
        o.CanCollide = false
    end
end
local function checkDamage(health)
    local r = Rush
    local _,_,currentHum=alive(Me)
    if not currentHum then return end
    health=currentHum.Health
    if not r or not CONFIG.DamageReturn or health <= 0 then return end
    if r.Phase ~= "HOLD" and r.Phase ~= "RETURN_DELAY"
        and r.Phase ~= "RETREAT_OUT" and r.Phase ~= "RETREAT_WAIT" then return end
    if r.Kind == "TOOL" and not getHeldTool() then return end
    r.HealthPeak = math.max(r.HealthPeak or health, health)
    if r.HealthPeak-health > currentHum.MaxHealth*CONFIG.DamagePercent/100 then
        forceReturn("MAT MAU > " .. CONFIG.DamagePercent .. "% - QUAY VE", true)
    end
end
local function prepareOwnCharacter()
    local c, r, h = alive(Me)
    if not c then return nil end
    if ManagedChar ~= c then
        releaseOwnCharacter()
        ManagedChar, ManagedHum = c, h
        StateSaved=h:GetStateEnabled(Enum.HumanoidStateType.Freefall)
        SavedMotion = {AutoRotate=h.AutoRotate, WalkSpeed=h.WalkSpeed,
            JumpPower=h.JumpPower, JumpHeight=h.JumpHeight}
        for _, o in ipairs(c:GetDescendants()) do savePart(o) end
        PartConnection = c.DescendantAdded:Connect(savePart)
        HealthConnection = h.HealthChanged:Connect(checkDamage)
    end
    h.AutoRotate = false
    if CONFIG.DisableOwnMovement then h.WalkSpeed=0; h.JumpPower=0; h.JumpHeight=0 end
    for part in pairs(SavedCollisions) do
        if part.Parent then part.CanCollide=false else SavedCollisions[part]=nil end
    end
    updateStandPad()
    return c, r, h
end
