forceReturn = function(message, instant)
    if not Rush then return end
    local _, root = alive(Me)
    local _, target = alive(SelectedPlayer)
    if not root or not target then Rush=nil; releaseOwnCharacter(); return end
    if instant then
        Rush=nil
        resetFollowPose()
        placeOwnCharacter(followCFrame(target))
    else
        Rush.Phase="RETURN"; Rush.PhaseStart=os.clock(); Rush.StartCF=root.CFrame
        Rush.PendingPunch=nil
    end
    status(message or "QUAY VE")
end

beginAction = function(kind, tool, respectCooldown, customHold)
    if destroyed or not Following or not alive(Me) or not alive(SelectedPlayer) then return false end
    if kind == "TOOL" and (not tool or tool.Parent ~= Me.Character
        or (respectCooldown and not tool.Enabled)) then return false end
    local slot, def = definition(tool)
    local now = os.clock()
    if tool and respectCooldown and now < (Cooldowns[tool] or 0) then return false end
    if kind == "PUNCH" and Rush and Rush.Phase == "RETREAT_WAIT"
        and now-Rush.PhaseStart < CONFIG.RetreatMinWait then
        local pending = Rush.PendingPunch
        Rush.PendingPunch = {Hold=math.min(CONFIG.PunchMax,
            (pending and pending.Hold or 0)+CONFIG.PunchHold)}
        return true
    end
    if kind == "PUNCH" and Rush and Rush.Kind == "PUNCH"
        and (Rush.Phase == "HOLD" or Rush.Phase == "DELAY" or Rush.Phase == "OUT")
        and eligible(Rush.EnemyPlayer) then
        Rush.Settings.BehindHold=math.min(CONFIG.PunchMax,
            Rush.Settings.BehindHold+CONFIG.PunchHold)
        Rush.PhaseStart=now
        if Rush.Phase=="OUT" then Rush.StartCF=select(2,alive(Me)).CFrame end
        status("PUNCH + " .. CONFIG.PunchHold .. "s | " .. Rush.Settings.BehindHold .. "s")
        return true
    end
    local wasRetreat=Rush and (Rush.Phase=="RETREAT_WAIT" or Rush.Phase=="RETREAT_OUT")
    local previousEnemy=wasRetreat and Rush.EnemyPlayer or nil
    local previousApproach=wasRetreat and Rush.Settings.Approach or nil
    local enemy=(kind=="PUNCH" and previousEnemy and eligible(previousEnemy))
        and previousEnemy or selectSkillTarget(def.Radius)
    if not enemy then
        Rush=nil
        return false
    end
    local hold = kind == "PUNCH" and math.min(CONFIG.PunchMax, customHold or CONFIG.PunchHold)
        or kind == "DASH" and CONFIG.DashHold or def.BehindHold
    local delay = kind == "PUNCH" and CONFIG.PunchDelay
        or kind == "DASH" and CONFIG.DashDelay or def.Delay
    if tool then Cooldowns[tool]=now+def.Cooldown end
    Rush = {Kind=kind, Tool=tool, Slot=slot, EnemyPlayer=enemy,
        CastForward=flatUnit(select(2,alive(enemy)).CFrame.LookVector),
        Phase="DELAY", PhaseStart=now, StartCF=nil,
        Retreated=kind=="PUNCH" and previousEnemy==enemy,
        Settings={Delay=delay, TravelTime=def.TravelTime, ReturnTime=def.ReturnTime,
            BehindHold=hold, ReturnDelay=def.ReturnDelay,
            Approach=kind=="PUNCH" and previousApproach or def.Approach}}
    resetFollowPose()
    setFlightEnabled(false)
    if delay<=0 and (kind=="PUNCH" or (tool and tool.Name=="Normal Punch")) then
        local _,enemyRoot=alive(enemy)
        local _,_,hum=alive(Me)
        placeOwnCharacter(skillCFrame(enemyRoot,Rush.Settings.Approach))
        Rush.Phase="HOLD"; Rush.PhaseStart=now; Rush.HealthPeak=hum.Health
    end
    return true
end
local function updateMovement(dt)
    if destroyed or not Following then return end
    local _, targetRoot = alive(SelectedPlayer)
    if not targetRoot then
        Rush=nil
        if not Suspended or ManagedChar then
            Suspended=true; releaseOwnCharacter(); status("PLAYER CHET - THA VA CHO HOI SINH")
        end
        return
    end
    local c, root, hum = prepareOwnCharacter()
    if not c then Rush=nil; releaseOwnCharacter(); return end
    if Suspended then Suspended=false; status("PLAYER HOI SINH - BAM TIEP") end
    local r, now = Rush, os.clock()
    if not r then smoothFollow(targetRoot,dt); return end
    setFlightEnabled(r.Phase=="DELAY")
    if not eligible(r.EnemyPlayer) and r.Phase ~= "RETURN" then
        forceReturn("BO QUA TARGET FRIENDLY / Y QUA XA", true)
        return
    end
    local _, enemyRoot = alive(r.EnemyPlayer)
    local def = r.Settings
    local elapsed = now-r.PhaseStart
    if r.Phase == "DELAY" then
        if elapsed < def.Delay then smoothFollow(targetRoot,dt); return end
        setFlightEnabled(false)
        if r.Kind=="PUNCH" or r.Kind=="DASH" or def.TravelTime<=0 then
            placeOwnCharacter(skillCFrame(enemyRoot,def.Approach))
            r.Phase="HOLD"; r.PhaseStart=now; r.HealthPeak=hum.Health
            return
        end
        r.Phase="OUT"; r.PhaseStart=now; r.StartCF=root.CFrame
        return
    elseif r.Phase == "OUT" then
        local t=math.clamp(elapsed/math.max(0.01, def.TravelTime), 0, 1)
        placeOwnCharacter(r.StartCF:Lerp(skillCFrame(enemyRoot, def.Approach), t))
        if t >= 1 then
            r.Phase="HOLD"; r.PhaseStart=now; r.HealthPeak=hum.Health
        end
    elseif r.Phase == "HOLD" or r.Phase == "RETURN_DELAY" then
        checkDamage(hum.Health)
        if Rush ~= r or r.Phase == "RETURN" then return end
        if CONFIG.RetreatEnabled and not r.Retreated
            and r.EnemyPlayer.Character:FindFirstChildOfClass("Tool") then
            r.Retreated=true; r.Phase="RETREAT_OUT"; r.PhaseStart=now
            r.StartCF=root.CFrame
            local retreatPos=enemyRoot.Position-flatUnit(enemyRoot.CFrame.LookVector)*CONFIG.RetreatDistance
            r.RetreatCF=CFrame.lookAt(retreatPos,retreatPos+flatUnit(enemyRoot.CFrame.LookVector))
            return
        end
        placeOwnCharacter(skillCFrame(enemyRoot, def.Approach))
        if r.Phase == "HOLD" and elapsed >= def.BehindHold then
            r.Phase="RETURN_DELAY"; r.PhaseStart=now
        elseif r.Phase == "RETURN_DELAY" and elapsed >= def.ReturnDelay then
            forceReturn("HET THOI GIAN", false)
        end
    elseif r.Phase == "RETREAT_OUT" then
        checkDamage(hum.Health)
        if Rush ~= r then return end
        local t=math.clamp(elapsed/math.max(0.01, CONFIG.RetreatTime), 0, 1)
        placeOwnCharacter(r.StartCF:Lerp(r.RetreatCF, t))
        if t >= 1 then r.Phase="RETREAT_WAIT"; r.PhaseStart=now end
    elseif r.Phase == "RETREAT_WAIT" then
        checkDamage(hum.Health)
        if Rush ~= r then return end
        placeOwnCharacter(r.RetreatCF)
        if r.PendingPunch and elapsed >= CONFIG.RetreatMinWait then
            local hold=r.PendingPunch.Hold
            beginAction("PUNCH", nil, false, hold)
        elseif elapsed >= CONFIG.RetreatHold then
            forceReturn("HET THOI GIAN LUI", false)
        end
    elseif r.Phase == "RETURN" then
        local t=math.clamp(elapsed/math.max(0.01, def.ReturnTime), 0, 1)
        placeOwnCharacter(r.StartCF:Lerp(followCFrame(targetRoot), t))
        if t >= 1 then Rush=nil; resetFollowPose() end
    end
end

