connect(RunService.Heartbeat,function()
    if destroyed then return end
    local now=os.clock()
    if HealthLabel then
        local char=Me.Character
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        HealthLabel.Text=hum and string.format("HP  %.1f / %.1f",hum.Health,hum.MaxHealth) or "HP  --"
    end
    
    -- AUTO ATTACK & TOOL SPAM LOGIC
    if Following and SelectedPlayer and alive(SelectedPlayer) then
        if CONFIG.AutoAttack then
            if now - (lastAutoAttack or 0) >= CONFIG.AutoAttackInterval then
                beginAction("PUNCH", nil, false)
                lastAutoAttack = now
            end
        end
        if CONFIG.AutoToolSpam then
            if now - (lastAutoTool or 0) >= CONFIG.AutoToolInterval then
                local tool = getHeldTool()
                if tool then
                    beginAction("TOOL", tool, false)
                    lastAutoTool = now
                end
            end
        end
    end

    if now>=nextScan then
        nextScan=now+0.75; scanTools(); scanTouch(); RefreshCatalog()
        for tool,links in pairs(ToolLinks) do
            if tool.Parent~=Backpack and tool.Parent~=Me.Character then
                for _,c in ipairs(links) do c:Disconnect() end
                ToolLinks[tool]=nil
            end
        end
    end
    if now>=nextCooldown then
        nextCooldown=now+0.15
        for i,s in ipairs(Slots) do
            local tool=getOwnedTool(s.Name)
            local left=tool and math.max(0,(Cooldowns[tool] or 0)-now) or 0
            miniButtons[i].Text=left>0 and string.format("S%d | %.1fs",i,left)
                or "S"..i.." | "..string.sub(s.Name,1,11)
        end
    end
end)
