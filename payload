local ToolDrag, Ghost
local clickSuppression=0
local function pointerEnds(input,original)
    return input==original or (input.UserInputType==Enum.UserInputType.MouseButton1
        and original.UserInputType==Enum.UserInputType.MouseButton1)
end
local function inside(point,o)
    if collapsed or not MainPage.Visible then return false end
    local p,s=o.AbsolutePosition,o.AbsoluteSize
    local vp,vs=MainPage.AbsolutePosition,MainPage.AbsoluteSize
    return point.X>=p.X and point.X<=p.X+s.X and point.Y>=p.Y and point.Y<=p.Y+s.Y
        and point.Y>=vp.Y and point.Y<=vp.Y+vs.Y
end
connect(UIS.InputChanged,function(input)
    local d=ToolDrag
    if not d then return end
    if input~=d.Input and not (d.Input.UserInputType==Enum.UserInputType.MouseButton1
        and input.UserInputType==Enum.UserInputType.MouseMovement) then return end
    if not d.Dragged and (input.Position-d.Start).Magnitude>10 then
        d.Dragged=true; ToolList.ScrollingEnabled=false; MainPage.ScrollingEnabled=false
        Ghost=label(Screen,d.Name,0,0,180,42,16)
        Ghost.BackgroundTransparency=0; Ghost.BackgroundColor3=C.Green; Ghost.ZIndex=100
        corner(Ghost)
    end
    if Ghost then Ghost.Position=UDim2.fromOffset(input.Position.X-90,input.Position.Y-21) end
end)
connect(UIS.InputEnded,function(input)
    local d=ToolDrag
    if not d or not pointerEnds(input,d.Input) then return end
    ToolDrag=nil
    if d.Dragged then
        clickSuppression=os.clock()+0.3
        for i,b in ipairs(slotButtons) do if inside(input.Position,b) then assignTool(d.Name,i); break end end
    end
    ToolList.ScrollingEnabled=true; MainPage.ScrollingEnabled=true
    if Ghost then Ghost:Destroy(); Ghost=nil end
end)
local catalogSignature=""
RefreshCatalog=function()
    if ToolDrag then return end
    local names={}
    local function gather(parent)
        if not parent then return end
        for _,o in ipairs(parent:GetDescendants()) do if o:IsA("Tool") then names[o.Name]=true end end
    end
    gather(Backpack); gather(Me.Character)
    gather(ReplicatedStorage:FindFirstChild("Tools")); gather(workspace:FindFirstChild("ToolsDrops"))
    for _,s in ipairs(Slots) do if s.Name~="" then names[s.Name]=true end end
    local sorted={}
    for name in pairs(names) do table.insert(sorted,name) end
    table.sort(sorted)
    local sign={}
    for _,name in ipairs(sorted) do table.insert(sign,name..":"..tostring(getOwnedTool(name)~=nil)) end
    local signature=table.concat(sign,"\n")
    if signature==catalogSignature then return end
    catalogSignature=signature
    for _,o in ipairs(ToolList:GetChildren()) do if o:IsA("TextButton") then o:Destroy() end end
    for _,name in ipairs(sorted) do
        local toolName=name
        local b=button(ToolList,(getOwnedTool(name) and "* " or "? ")..name,0,0,188,44,function()
            if os.clock()<clickSuppression then return end
            PickedToolName=toolName; status("CHON "..toolName.." - CHAM SLOT DE GAN")
        end,getOwnedTool(name) and C.Green or C.Input)
        b.TextSize=13
        connect(b.InputBegan,function(input)
            if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
                ToolDrag={Name=toolName,Input=input,Start=input.Position,Dragged=false}
            end
        end)
    end
    ToolList.CanvasSize=UDim2.fromOffset(#sorted*195,0)
end

local function bindTool(tool)
    if not tool:IsA("Tool") or ToolLinks[tool] then return end
    local links={}; ToolLinks[tool]=links
    links[1]=tool.Equipped:Connect(function()
        if CONFIG.AutoRushOnEquip and os.clock()>=(SuppressEquip[tool] or 0)
            and os.clock()-(EquippedAt[tool] or -10)>0.05 then
            EquippedAt[tool]=os.clock(); beginAction("TOOL",tool,true)
        end
    end)
    links[2]=tool.Activated:Connect(function()
        if os.clock()<(SuppressActivation[tool] or 0) then return end
        beginAction("TOOL",tool,false)
    end)
    links[3]=tool.Destroying:Connect(function()
        for _,c in ipairs(links) do c:Disconnect() end
        ToolLinks[tool]=nil
    end)
end
local function scanTools()
    for _,parent in ipairs({Backpack,Me.Character}) do
        for _,o in ipairs(parent:GetChildren()) do bindTool(o) end
    end
end
equipSlot=function(slot)
    local tool=getOwnedTool(Slots[slot].Name)
    local c,_,hum=alive(Me)
    if not c or not tool then status("TOOL KHONG NAM TRONG BACKPACK"); return end
    if not Following or not tool.Enabled then status("BAT BAM / CHO TOOL SAN SANG"); return end
    if not selectSkillTarget(Slots[slot].Radius) then status("KHONG CO MUC TIEU HOP LE"); return end
    if os.clock()<(Cooldowns[tool] or 0) then status("TOOL COOLDOWN"); return end
    bindTool(tool)
    SuppressEquip[tool]=os.clock()+0.5
    if tool.Parent~=c then hum:EquipTool(tool) end
    if not beginAction("TOOL",tool,true) then return end
    SuppressActivation[tool]=os.clock()+0.05
    tool:Activate()
end

local function scanTouch()
    local punch,dash=false,false
    local valid={}
    for _,touch in ipairs(PlayerGui:GetDescendants()) do
        if touch.Name=="TouchGui" then
            local control=touch:FindFirstChild("TouchControlFrame",true)
            if control then
                for _,b in ipairs(control:GetDescendants()) do
                    if b:IsA("GuiButton") and (b.Name=="PunchButton" or b.Name=="DashButton") then
                        valid[b]=true
                        if b.Name=="PunchButton" then punch=true else dash=true end
                        if not TouchLinks[b] then
                            local kind=b.Name=="PunchButton" and "PUNCH" or "DASH"
                            TouchLinks[b]=b.Activated:Connect(function()
                                if kind=="PUNCH" and CONFIG.TouchPunch then beginAction("PUNCH",nil,false)
                                elseif kind=="DASH" and CONFIG.TouchDash then beginAction("DASH",nil,false) end
                            end)
                        end
                    end
                end
            end
        end
    end
    for b,c in pairs(TouchLinks) do if not valid[b] then c:Disconnect(); TouchLinks[b]=nil end end
    TouchLabel.Text="PunchButton: "..(punch and "OK" or "CHUA CO").."   |   DashButton: "..(dash and "OK" or "CHUA CO")
end
