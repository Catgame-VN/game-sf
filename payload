local function alive(player)
    local c = player and player.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if c and r and h and h.Health > 0 and r:IsDescendantOf(workspace) then
        return c, r, h
    end
end
local function flatUnit(v)
    local p = Vector3.new(v.X, 0, v.Z)
    return p.Magnitude > 0.001 and p.Unit or Vector3.new(0, 0, -1)
end
local function facing(pos, to, allowY, fallback)
    local d = to-pos
    if not allowY then d = Vector3.new(d.X, 0, d.Z) end
    if d.Magnitude < 0.001 then d = fallback or Vector3.new(0, 0, -1) end
    if not allowY then d = flatUnit(d) end
    return CFrame.lookAt(pos, pos+d.Unit)
end
local function followCFrame(root)
    local forward = flatUnit(root.CFrame.LookVector)
    local right = Vector3.new(-forward.Z, 0, forward.X)
    local pos = root.Position + right*CONFIG.Side - forward*CONFIG.Behind
        + Vector3.new(0, CONFIG.Height, 0)
    if CONFIG.FaceFollowTarget then return facing(pos, root.Position, CONFIG.AimY, forward) end
    return CFrame.lookAt(pos, pos+forward)
end
local function skillCFrame(root, distance)
    local forward=(Rush and Rush.CastForward) or flatUnit(root.CFrame.LookVector)
    if CONFIG.AntiDelayHitbox then
        local velocity=root.AssemblyLinearVelocity
        local horizontal=Vector3.new(velocity.X,0,velocity.Z)
        local direction=horizontal.Magnitude>=3 and horizontal.Unit or forward
        local lead=horizontal*CONFIG.HitboxLeadTime
        if lead.Magnitude>CONFIG.HitboxMaxLead then lead=lead.Unit*CONFIG.HitboxMaxLead end
        local pos=root.Position+lead+direction*distance
        return CFrame.lookAt(pos,pos-forward)
    end
    local pos=root.Position-forward*distance
    return CFrame.lookAt(pos,pos+forward)
end
local function removeFlight()
    if FlightPosition then FlightPosition:Destroy(); FlightPosition=nil end
    if FlightOrientation then FlightOrientation:Destroy(); FlightOrientation=nil end
    if FlightAttachment then FlightAttachment:Destroy(); FlightAttachment=nil end
    FlightRoot=nil
end
local function setFlightEnabled(enabled)
    if FlightPosition then FlightPosition.Enabled=enabled end
    if FlightOrientation then FlightOrientation.Enabled=enabled end
end
local function ensureFlight(root)
    if FlightRoot==root and FlightPosition and FlightPosition.Parent then return end
    removeFlight()
    FlightRoot=root
    FlightAttachment=Instance.new("Attachment"); FlightAttachment.Name="FollowFlightAttachment"; FlightAttachment.Parent=root
    FlightPosition=Instance.new("AlignPosition")
    FlightPosition.Name="FollowFlightPosition"
    FlightPosition.Mode=Enum.PositionAlignmentMode.OneAttachment
    FlightPosition.Attachment0=FlightAttachment
    FlightPosition.RigidityEnabled=false; FlightPosition.ApplyAtCenterOfMass=true
    FlightPosition.MaxForce=1000000; FlightPosition.MaxVelocity=CONFIG.FlightMaxSpeed
    FlightPosition.Responsiveness=CONFIG.FollowResponse
    FlightPosition.Position=root.Position; FlightPosition.Parent=root
    FlightOrientation=Instance.new("AlignOrientation")
    FlightOrientation.Name="FollowFlightOrientation"
    FlightOrientation.Mode=Enum.OrientationAlignmentMode.OneAttachment
    FlightOrientation.Attachment0=FlightAttachment
    FlightOrientation.RigidityEnabled=false; FlightOrientation.MaxTorque=1000000
    FlightOrientation.Responsiveness=CONFIG.FollowResponse
    FlightOrientation.CFrame=root.CFrame; FlightOrientation.Parent=root
end
local function updateStandPad()
    local char,root,hum=alive(Me)
    if not char or not ManagedHum then return end
    if CONFIG.FootPad then
        if not FootPad or not FootPad.Parent then
            FootPad=Instance.new("Part")
            FootPad.Name="SmoothFollow_FootPad"
            FootPad.Size=Vector3.new(5,0.15,5)
            FootPad.Anchored=true
            FootPad.CanCollide=false; FootPad.CanTouch=false; FootPad.CanQuery=false
            FootPad.Transparency=0.55
            FootPad.Material=Enum.Material.Neon
            FootPad.Color=Color3.fromRGB(57,160,255)
            FootPad.Parent=workspace
        end
        local bottom=root.Position.Y-root.Size.Y/2-hum.HipHeight
        for _,name in ipairs({"LeftFoot","RightFoot","Left Leg","Right Leg"}) do
            local foot=char:FindFirstChild(name)
            if foot and foot:IsA("BasePart") then bottom=math.min(bottom,foot.Position.Y-foot.Size.Y/2) end
        end
        FootPad.CFrame=CFrame.new(root.Position.X,bottom-0.08,root.Position.Z)
    elseif FootPad then FootPad:Destroy(); FootPad=nil end
    if CONFIG.AirStand then
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall,false)
        local state=hum:GetState()
        if state==Enum.HumanoidStateType.Freefall or state==Enum.HumanoidStateType.Jumping
            or state==Enum.HumanoidStateType.FallingDown then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
        if os.clock()>=NextIdleCheck then
            NextIdleCheck=os.clock()+0.25
            local animate=char:FindFirstChild("Animate")
            local idle=animate and animate:FindFirstChild("idle")
            local fall=animate and animate:FindFirstChild("fall")
            local fallAnim=fall and fall:FindFirstChildWhichIsA("Animation",true)
            local animator=hum:FindFirstChildOfClass("Animator")
            local anim=idle and idle:FindFirstChildWhichIsA("Animation",true)
            if animator then
                for _,track in ipairs(animator:GetPlayingAnimationTracks()) do
                    local name=track.Name:lower()
                    if name=="fall" or name=="freefall" or name=="fallanim"
                        or (fallAnim and track.Animation and track.Animation.AnimationId==fallAnim.AnimationId) then
                        track:Stop(0.05)
                    end
                end
            end
            if not IdleTrack and anim and animator then
                local ok,track=pcall(function() return animator:LoadAnimation(anim) end)
                if ok then IdleTrack=track; IdleTrack.Looped=true; IdleTrack.Priority=Enum.AnimationPriority.Idle end
            end
        end
        if IdleTrack and not IdleTrack.IsPlaying then IdleTrack:Play(0.08) end
    else
        if StateSaved~=nil then hum:SetStateEnabled(Enum.HumanoidStateType.Freefall,StateSaved) end
        if IdleTrack and IdleTrack.IsPlaying then IdleTrack:Stop(0.08) end
    end
end
local function placeOwnCharacter(cf)
    local c, r = alive(Me)
    if not c then return false end
    local rootToPivot = r.CFrame:ToObjectSpace(c:GetPivot())
    c:PivotTo(cf*rootToPivot)
    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero
    updateStandPad()
    return true
end
local function resetFollowPose()
    FollowPose,FollowRoot,FollowLastPosition=nil,nil,nil
end
local function smoothFollow(root,dt)
    local _,ownRoot=alive(Me)
    if not ownRoot then return end
    ensureFlight(ownRoot)
    dt=math.clamp(dt or 1/60,0,0.1)
    local goal=followCFrame(root)
    if FollowRoot~=root or not FollowPose then
        FollowRoot=root; FollowPose=goal; FollowLastPosition=root.Position
    else
        FollowPose=FollowPose:Lerp(goal,1-math.exp(-CONFIG.FollowResponse*dt))
        FollowLastPosition=root.Position
    end
    local lead=root.AssemblyLinearVelocity*CONFIG.FollowLookAhead
    if lead.Magnitude>2 then lead=lead.Unit*2 end
    setFlightEnabled(true)
    FlightPosition.Position=FollowPose.Position+lead
    FlightPosition.MaxVelocity=CONFIG.FlightMaxSpeed
    FlightPosition.Responsiveness=CONFIG.FollowResponse
    FlightOrientation.CFrame=FollowPose
    FlightOrientation.Responsiveness=CONFIG.FollowResponse
    updateStandPad()
end
local function getHeldTool()
