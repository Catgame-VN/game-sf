local function copyTable(t)
    local out={}
    for k,v in pairs(t) do out[k]=type(v)=="table" and copyTable(v) or v end
    return out
end
local function bounded(n, bounds)
    return type(n)=="number" and n==n and n>=bounds[1] and n<=bounds[2]
end
local function validateConfig(data)
    if type(data)~="table" or data.Version~=6 or type(data.Config)~="table"
        or type(data.Slots)~="table" or #data.Slots~=4 then return nil end
    local c, ss = {}, {}
    for k,v in pairs(CONFIG) do
        local x=data.Config[k]
        if x==nil and NewDefaults[k]~=nil then x=NewDefaults[k] end
        if k=="Friendly" then
            if type(x)~="table" then return nil end
            local count=0
            local friends={}
            for id,b in pairs(x) do
                count=count+1
                if count>1000 or type(id)~="string" or #id>20
                    or not id:match("^%d+$") or type(b)~="boolean" then return nil end
                friends[id]=b
            end
            x=friends
        elseif ConfigBounds[k] then
            if not bounded(x, ConfigBounds[k]) then return nil end
        elseif type(v)=="boolean" then
            if type(x)~="boolean" then return nil end
        elseif k=="Mode" and x~="PROTECT" and x~="ELIMINATE" then return nil end
        c[k]=x
    end
    if c.PunchMax<c.PunchHold or c.RetreatMinWait>c.RetreatHold then return nil end
    local assigned={}
    for i=1,4 do
        local s=data.Slots[i]
        if type(s)~="table" or type(s.Name)~="string" or #s.Name>120 then return nil end
        if s.Name~="" and assigned[s.Name] then return nil end
        assigned[s.Name]=true
        ss[i]={Name=s.Name}
        for k,b in pairs(SkillBounds) do
            if not bounded(s[k],b) then return nil end
            ss[i][k]=s[k]
        end
    end
    return c, ss
end
local function checksum(s)
    local h=7
    for i=1,#s do h=(h*31+string.byte(s,i))%2147483647 end
    return tostring(h)
end
local function hexEncode(s)
    return (s:gsub(".",function(x) return string.format("%02X",string.byte(x)) end))
end
local function hexDecode(s)
    if #s%2~=0 or s:find("[^0-9A-Fa-f]") then return nil end
    return (s:gsub("..",function(x) return string.char(tonumber(x,16)) end))
end
local function generateCode()
    local json=Http:JSONEncode({Version=6, Config=copyTable(CONFIG), Slots=copyTable(Slots)})
    local id=Http:GenerateGUID(false)
    return "SF6|" .. id .. "|" .. checksum(id .. "|" .. json) .. "|" .. hexEncode(json), id
end
local function decodeCode(code)
    if type(code)~="string" or #code>100000 then return nil end
    code=code:gsub("%s", "")
    local id,hash,hex=code:match("^SF6|([%x%-]+)|(%d+)|([%x]+)$")
    if not id or #id~=36 then return nil end
    local json=hexDecode(hex)
    if not json or checksum(id .. "|" .. json)~=hash then return nil end
    local ok,data=pcall(function() return Http:JSONDecode(json) end)
    if not ok then return nil end
    local c,ss=validateConfig(data)
    if not c then return nil end
    return c,ss,id
end

