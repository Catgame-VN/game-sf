local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Workspace           = game:GetService("Workspace")
local LocalPlayer         = Players.LocalPlayer

-- ══════════════════════════════════════
--  STATE
-- ══════════════════════════════════════
_G.flag                          = false
_G.antiRagdollActive             = false
_G.secondaryCreateTextButtonFlag = false
_G.lookAboveActive               = false
_G.xrayActive                    = false

_G.player            = nil
_G.striking          = false
_G.currentTrack      = nil
_G.ragdollCheckDelay = 0.05

-- Kill tracking
_G.killCount         = 0
_G.sessionKills      = 0
_G.trackedHealth     = {}   -- [player] = lastHP

-- Khoảng cách ngang cố định từ target HRP (studs)
local RANGE_OFFSET = 8

-- ══════════════════════════════════════
--  HELPERS
-- ══════════════════════════════════════

-- Ưu tiên enemy ít máu nhất còn sống
local function getBestTarget()
    local best, bestHP = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer
            and p.Character
            and p.Character:FindFirstChild("Humanoid")
            and p.Character.Humanoid.Health > 0
        then
            local hp = p.Character.Humanoid.Health
            if hp < bestHP then
                bestHP = hp
                best   = p
            end
        end
    end
    return best
end

local function isTargetValid(p)
    return p
        and p.Character
        and p.Character:FindFirstChild("HumanoidRootPart")
        and p.Character:FindFirstChild("Humanoid")
        and p.Character.Humanoid.Health > 0
end

local function sendKey(down, key)
    VirtualInputManager:SendKeyEvent(down, key, false, game)
end

local function sendMouse(down)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, down, game, 0)
end

local function spamSkills()
    for _, key in ipairs({
        Enum.KeyCode.One, Enum.KeyCode.Two,
        Enum.KeyCode.Three, Enum.KeyCode.Four,
    }) do
        if not _G.flag then break end
        sendKey(true,  key) ; task.wait(0.02)
        sendKey(false, key)
    end
end

-- ══════════════════════════════════════
--  KILL DETECTION
--  Theo dõi HP target — khi về 0 → kill
-- ══════════════════════════════════════
local killLabel = nil   -- Rayfield label ref (set after UI build)

local function onKill(victimName)
    _G.killCount    = _G.killCount + 1
    _G.sessionKills = _G.sessionKills + 1
    warn(string.format("[TSB Kill #%d] Killed: %s | Session: %d", _G.killCount, victimName, _G.sessionKills))
    -- cập nhật label nếu UI đã có
    if killLabel and killLabel.Set then
        killLabel:Set("Kills this session: " .. _G.sessionKills)
    end
end

-- Health watcher chạy liên tục
task.spawn(function()
    while true do
        task.wait(0.1)
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if not hum then
                _G.trackedHealth[p] = nil
                continue
            end
            local hp = hum.Health
            local prev = _G.trackedHealth[p]
            if prev and prev > 0 and hp <= 0 then
                -- target vừa chết — chỉ count nếu đang farm và đây là target
                if _G.flag then
                    onKill(p.Name)
                end
                -- re-pick target ngay
                if _G.player == p then
                    _G.player = nil
                end
            end
            _G.trackedHealth[p] = hp
        end
    end
end)

-- ══════════════════════════════════════
--  LOOK ABOVE MAP  (camera)
-- ══════════════════════════════════════
RunService.RenderStepped:Connect(function()
    local camera = Workspace.CurrentCamera
    if not camera then return end

    local wantAbove = (_G.lookAboveActive or _G.xrayActive)
                      and _G.flag
                      and _G.player
                      and _G.player.Character

    if wantAbove then
        local hrp = _G.player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            camera.CameraType = Enum.CameraType.Scriptable
            camera.CFrame = CFrame.new(
                hrp.Position + Vector3.new(0, 14, 0),
                hrp.Position
            )
        end
    else
        if camera.CameraType == Enum.CameraType.Scriptable then
            camera.CameraType = Enum.CameraType.Custom
        end
    end
end)

