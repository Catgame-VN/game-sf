    info         = "Camera nhìn từ trên xuống target khi farm — thấy được ai đang đứng dưới map",
    currentValue = false,
    callback     = function(v)
        _G.lookAboveActive = v
        _G.xrayActive      = v
    end,
})

combatTab:CreateToggle({
    name         = "Auto Block",
    info         = "Spam phím F để block liên tục",
    currentValue = false,
    callback     = function(v)
        _G.secondaryCreateTextButtonFlag = v
    end,
})

combatTab:CreateToggle({
    name         = "Anti-Ragdoll",
    info         = "Ngăn nhân vật bị ragdoll",
    currentValue = false,
    callback     = function(v) _G.antiRagdollActive = v end,
})

combatTab:CreateSlider({
    name         = "Anti-Ragdoll Delay",
    range        = {0.01, 0.5},
    increment    = 0.01,
    currentValue = 0.05,
    suffix       = " s",
    callback     = function(v) _G.ragdollCheckDelay = v end,
})

combatTab:CreateButton({
    name     = "Pick New Target",
    callback = function()
        _G.player = getRandomEnemy()
        if _G.player then
            Rayfield:Notify({
                title    = "Target",
                content  = "Locked: " .. _G.player.Name,
                duration = 3,
            })
        else
            Rayfield:Notify({
                title    = "No Target",
                content  = "Không tìm thấy enemy sống",
                duration = 3,
            })
        end
    end,
})
