        "Test Webhook",
        "**Candy collected:** " .. candyCollected ..
        "\n**Doors knocked:** " .. doorsKnocked ..
        "\n**Last door candy:** " .. lastDoorCandy ..
        "\n**Session:** " .. formatTime(tick() - hopStart),
        0x50dc8c
    )
    webhookUrl = old
    addLog("Test sent")
end)

