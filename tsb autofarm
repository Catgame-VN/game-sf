local function refreshPanelVisibility()
    local targetPos = guiVisible and UDim2.new(0.5, -170, 0, 50) or UDim2.new(0.5, -170, 0, -300)
    local targetTrans = guiVisible and 0.08 or 1
    TweenService:Create(panel, TweenInfo.new(0.35, Enum.EasingStyle.Quint), {
        Position = targetPos,
        BackgroundTransparency = targetTrans,
    }):Play()
    if not guiVisible then
        task.delay(0.4, function()
            panel.Visible = false
        end)
    else
        panel.Visible = true
    end
end

