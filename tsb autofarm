local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Workspace           = game:GetService("Workspace")
local LocalPlayer         = Players.LocalPlayer

-- ══════════════════════════════════════
--  STATE
-- ══════════════════════════════════════
_G.flag                          = false
_G.antiRagdollActive             = false
_G.secondaryCreateTextButtonFlag = false
_G.lookAboveActive               = false
_G.xrayActive                    = false

_G.player                        = nil
_G.striking                      = false
_G.currentTrack                  = nil
_G.ragdollCheckDelay             = 0.05

-- ══════════════════════════════════════
--  TUNABLES
-- ══════════════════════════════════════
local UNDER_OFFSET   = 5     -- studs dưới target (đủ gần để hit)
local MAX_Y_ABOVE    = -3    -- trần: Y không bao giờ vượt mức này (luôn dưới đất)
local M1_INTERVAL    = 0.12

-- ══════════════════════════════════════
--  HELPERS
-- ══════════════════════════════════════
local function getRandomEnemy()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer
            and p.Character
            and p.Character:FindFirstChild("Humanoid")
            and p.Character.Humanoid.Health > 0
        then
            table.insert(list, p)
        end
    end
    if #list == 0 then return nil end
    return list[math.random(1, #list)]
end

local function sendKey(down, key)
    VirtualInputManager:SendKeyEvent(down, key, false, game)
end

-- Tính Y: luôn UNDER_OFFSET dưới target, nhưng không vượt MAX_Y_ABOVE
local function computeStandY(targetY)
    return math.min(targetY - UNDER_OFFSET, MAX_Y_ABOVE)
end

local function faceTarget()
    local char     = LocalPlayer.Character
    local localHrp = char and char:FindFirstChild("HumanoidRootPart")
    if not localHrp or not _G.player then return end

    local targetChar = _G.player.Character
    local targetHrp  = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHrp then return end

    local targetPos   = targetHrp.Position
    local standY      = computeStandY(targetPos.Y)
    local underTarget = Vector3.new(targetPos.X, standY, targetPos.Z)
    localHrp.CFrame = CFrame.lookAt(underTarget, targetPos)
end

-- ══════════════════════════════════════
--  PUNCH BUTTON LOCATOR
-- ══════════════════════════════════════
local punchCache = nil

local function isPunchCandidate(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("GuiButton") then return false end
    local n = string.lower(obj.Name)
    return n == "punchbutton"
        or n == "m1button"
        or n == "attackbutton"
        or string.find(n, "punch") ~= nil
        or string.find(n, "attack") ~= nil
        or string.find(n, "^m1") ~= nil
end

local function findPunchButton()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end

    for _, name in ipairs({ "PunchButton", "M1Button", "AttackButton" }) do
        local found = pg:FindFirstChild(name, true)
        if isPunchCandidate(found) then return found end
    end

    local best = nil
    for _, obj in ipairs(pg:GetDescendants()) do
        if isPunchCandidate(obj) then
            if obj.Visible and obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.Y > 0 then
                return obj
            end
            best = best or obj
        end
    end
    return best
end

local function fireM1()
    if not punchCache or not punchCache.Parent then
        punchCache = findPunchButton()
    end

    if punchCache and type(firesignal) == "function" then
        local ok = pcall(firesignal, punchCache.MouseButton1Click)
        if ok then return end
    end

    if punchCache and punchCache.Visible then
        local pos  = punchCache.AbsolutePosition
        local size = punchCache.AbsoluteSize
        if size.X > 0 and size.Y > 0 then
            local cx = math.floor(pos.X + size.X * 0.5)
            local cy = math.floor(pos.Y + size.Y * 0.5)
            pcall(function()
                VirtualInputManager:SendMouseMoveEvent(cx, cy, game)
            end)
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
            end)
            task.wait(0.02)
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
            end)
            return
        end
    end

    if type(mouse1click) == "function" then
        if pcall(mouse1click) then return end
    end
    if type(mouse1press) == "function" and type(mouse1release) == "function" then
        if pcall(function()
            mouse1press() ; task.wait(0.02) ; mouse1release()
        end) then return end
    end

    local camera = Workspace.CurrentCamera
    if not camera then return end
    local vp = camera.ViewportSize
    local cx = math.floor(vp.X * 0.5)
    local cy = math.floor(vp.Y * 0.5)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
    end)
    task.wait(0.02)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
    end)
end

local function spamSkills()
    for _, key in ipairs({
        Enum.KeyCode.One, Enum.KeyCode.Two,
        Enum.KeyCode.Three, Enum.KeyCode.Four
    }) do
        if not _G.flag then break end
        faceTarget()
        sendKey(true,  key) ; task.wait(0.02)
        faceTarget()
        sendKey(false, key)
    end
end

-- ══════════════════════════════════════
--  LOOK ABOVE MAP
-- ══════════════════════════════════════
RunService.RenderStepped:Connect(function()
    local camera = Workspace.CurrentCamera
    if not camera then return end

    local wantAbove = (_G.lookAboveActive or _G.xrayActive)
                      and _G.flag
                      and _G.player
                      and _G.player.Character

    if wantAbove then
        local hrp = _G.player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            camera.CameraType = Enum.CameraType.Scriptable
            camera.CFrame = CFrame.new(
                hrp.Position + Vector3.new(0, 14, 0),
                hrp.Position
            )
        end
    else
        if camera.CameraType == Enum.CameraType.Scriptable then
            camera.CameraType = Enum.CameraType.Custom
        end
    end
end)

-- ══════════════════════════════════════
--  AUTO BLOCK
-- ══════════════════════════════════════
local blockFrameCounter = 0
RunService.PreRender:Connect(function()
    if _G.secondaryCreateTextButtonFlag then
        blockFrameCounter = blockFrameCounter + 1
        if blockFrameCounter % 3 == 0 then
            sendKey(false, Enum.KeyCode.F)
            return
        end
        sendKey(true, Enum.KeyCode.F)
    else
        sendKey(false, Enum.KeyCode.F)
    end
end)

-- ══════════════════════════════════════
--  ANTI RAGDOLL
-- ══════════════════════════════════════
task.spawn(function()
    while true do
        task.wait(0.01)
        if _G.antiRagdollActive and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                local st = hum:GetState()
                if st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.FallingDown then
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,    false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    hrp.Anchored = true
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    task.wait(_G.ragdollCheckDelay)
                    hrp.Anchored = false
                end
            end
        end
    end
end)

-- ══════════════════════════════════════
--  AUTOFARM — POSITION LOOP
--  Y = target.Y - UNDER_OFFSET, cap MAX_Y_ABOVE (không trồi lên)
--  X/Z bám target
-- ══════════════════════════════════════
task.spawn(function()
    while true do
        task.wait(0.05)
        if not _G.flag then continue end

        if not _G.player
        or not _G.player.Character
        or not _G.player.Character:FindFirstChild("HumanoidRootPart")
        or _G.player.Character.Humanoid.Health <= 0
        then
            _G.player = getRandomEnemy()
            if not _G.player then task.wait(0.5) continue end
        end

        local char     = LocalPlayer.Character
        local localHrp = char and char:FindFirstChild("HumanoidRootPart")
        local targetHrp = _G.player.Character
                          and _G.player.Character:FindFirstChild("HumanoidRootPart")
        if not localHrp or not targetHrp then continue end

        local targetPos   = targetHrp.Position
        local standY      = computeStandY(targetPos.Y)
        local underTarget = Vector3.new(targetPos.X, standY, targetPos.Z)
        localHrp.CFrame = CFrame.lookAt(underTarget, targetPos)
    end
end)

-- ══════════════════════════════════════
--  AUTOFARM — M1 LOOP
-- ══════════════════════════════════════
task.spawn(function()
    while true do
        task.wait(M1_INTERVAL)
        if not _G.flag then continue end
        if not _G.player then continue end
        faceTarget()
        task.wait()
        fireM1()
    end
end)

-- ══════════════════════════════════════
--  AUTOFARM — SKILL SPAM LOOP
-- ══════════════════════════════════════
task.spawn(function()
    local ultimateTimer = tick()
    while true do
        task.wait(0.01)
        if not _G.flag then continue end
        if not _G.player then continue end

        _G.striking = true
        spamSkills()

        if tick() - ultimateTimer >= 5 then
            faceTarget()
            sendKey(true,  Enum.KeyCode.G) ; task.wait(0.02)
            faceTarget()
            sendKey(false, Enum.KeyCode.G)
            ultimateTimer = tick()
        end

        _G.striking = false
        task.wait(0.01)
    end
end)

