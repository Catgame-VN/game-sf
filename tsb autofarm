-- =====================================================
-- NUCLEAR LAG REDUCE
-- Xóa sạch: VFX, decal, texture, shadow, fog, bloom
-- Chạy ngay — trước mọi thứ khác
-- =====================================================
local lagApplied = false
local function applyLagReduce()
    if lagApplied then return end
    lagApplied = true

    -- Graphics minimum
    pcall(function() settings().Rendering.QualityLevel = 1 end)
    pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01 end)
    pcall(function() settings().Rendering.EagerBulkExecution = true end)

    -- Lighting nuclear
    Lighting.GlobalShadows       = false
    Lighting.FogEnd               = 9e9
    Lighting.FogStart             = 9e9
    Lighting.Brightness           = 2
    Lighting.Ambient              = Color3.fromRGB(180, 180, 180)
    Lighting.OutdoorAmbient       = Color3.fromRGB(180, 180, 180)
    Lighting.ShadowSoftness       = 0
    for _, v in ipairs(Lighting:GetChildren()) do
        pcall(function()
            if v:IsA("BlurEffect") or v:IsA("SunRaysEffect")
            or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect")
            or v:IsA("DepthOfFieldEffect") or v:IsA("Sky") then
                v.Enabled = false
                if v:IsA("Sky") then v:Destroy() end
            end
        end)
    end

    -- Hàm xóa VFX + decal + texture trên 1 instance và toàn bộ descendant
    local function nukeInstance(root)
        local ok, children = pcall(function() return root:GetDescendants() end)
        if not ok then return end
        for _, v in ipairs(children) do
            pcall(function()
                -- Particle / VFX
                if v:IsA("ParticleEmitter") then
                    v.Rate = 0
                    v.Enabled = false
                    v:Clear()
                elseif v:IsA("Beam") or v:IsA("Trail")
                    or v:IsA("Fire") or v:IsA("Smoke")
                    or v:IsA("Sparkles") or v:IsA("SelectionBox")
                    or v:IsA("SelectionSphere") then
                    v.Enabled = false
                -- Decal / texture trên map
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v.Transparency = 1
                -- Lights
                elseif v:IsA("PointLight") or v:IsA("SpotLight")
                    or v:IsA("SurfaceLight") then
                    v.Enabled = false
                -- Mesh detail
                elseif v:IsA("SpecialMesh") then
                    -- giữ mesh shape nhưng loại LOD nặng
                    pcall(function() v.LODFactor = 0 end)
                -- Shadow caster
                elseif v:IsA("BasePart") then
                    v.CastShadow     = false
                    v.ReceiveAge     = 0
                end
            end)
        end
    end

    -- Nuke toàn workspace (spawn để không block)
    task.spawn(function()
        nukeInstance(workspace)
        print("[LagReduce] workspace nuked")
    end)

    -- Nuke mỗi khi instance mới được thêm vào workspace (VFX skills người khác)
    workspace.DescendantAdded:Connect(function(v)
        pcall(function()
            -- Chỉ kill nếu không phải của mình
            local char = LP.Character
            if char and v:IsDescendantOf(char) then return end
            if v:IsA("ParticleEmitter") then
                v.Rate = 0; v.Enabled = false
            elseif v:IsA("Beam") or v:IsA("Trail") or v:IsA("Fire")
                or v:IsA("Smoke") or v:IsA("Sparkles") then
                v.Enabled = false
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = 1
            elseif v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
                v.Enabled = false
            elseif v:IsA("BasePart") and not v:IsDescendantOf(workspace.CurrentCamera) then
                v.CastShadow = false
            end
        end)
    end)

    -- Nuke lại sau khi spawn (game respawn thêm VFX mới)
    LP.CharacterAdded:Connect(function()
        task.wait(0.5)
        task.spawn(function() nukeInstance(workspace) end)
    end)

    print("[LagReduce] NUCLEAR applied")
end

applyLagReduce()

