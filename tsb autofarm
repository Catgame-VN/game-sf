-- ══════════════════════════════════════
--  ANTI RAGDOLL
-- ══════════════════════════════════════
task.spawn(function()
    while true do
        task.wait(0.01)
        if _G.antiRagdollActive and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                local st = hum:GetState()
                if st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.FallingDown then
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,    false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    hrp.Anchored = true
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    task.wait(_G.ragdollCheckDelay)
                    hrp.Anchored = false
                end
            end
        end
    end
end)

-- ══════════════════════════════════════
--  AUTOFARM — POSITION LOOP
--  Đứng cách target ~_G.rangeOffset studs
--  theo hướng ngang (không quá sát)
--  vẫn ở dưới map (-6.5 Y) để skill hit
-- ══════════════════════════════════════
task.spawn(function()
    while true do
        task.wait(0.08)
        if not _G.flag then continue end

        -- re-pick nếu target không hợp lệ
        if not isTargetValid(_G.player) then
            _G.player = getBestTarget()
            if not _G.player then task.wait(0.5) continue end
        end

        local char     = LocalPlayer.Character
        local localHrp = char and char:FindFirstChild("HumanoidRootPart")
        local targetHrp = _G.player.Character:FindFirstChild("HumanoidRootPart")
        if not localHrp or not targetHrp then continue end

        -- Dự đoán vị trí target tiếp theo
        local predOffset   = targetHrp.AssemblyLinearVelocity * 0.1
        local predictedPos = targetHrp.Position + predOffset

        -- Tính vector ngang từ local → target, normalize, offset ra _G.rangeOffset studs
        local flat = Vector3.new(
            predictedPos.X - localHrp.Position.X,
            0,
            predictedPos.Z - localHrp.Position.Z
        )
        local dist = flat.Magnitude
        local offsetDir
        if dist > 0.1 then
            offsetDir = flat.Unit * RANGE_OFFSET
        else
            offsetDir = Vector3.new(RANGE_OFFSET, 0, 0)
        end

        -- Khoá Y cứng dưới lòng đất bất kể target ở đâu
        local UNDERGROUND_Y = -100
        local standPos = Vector3.new(
            predictedPos.X - offsetDir.X,
            UNDERGROUND_Y,
            predictedPos.Z - offsetDir.Z
        )

        -- xoay Y về hướng target, pitch -90 để nhân vật nằm ngang úp xuống đất
        local yaw = CFrame.lookAt(standPos, Vector3.new(predictedPos.X, UNDERGROUND_Y, predictedPos.Z))
        localHrp.CFrame = CFrame.new(standPos)
            * CFrame.Angles(0, select(2, yaw:ToEulerAnglesYXZ()), 0)
            * CFrame.Angles(math.rad(90), 0, 0)
    end
end)

-- ══════════════════════════════════════
--  AUTOFARM — SKILL SPAM LOOP
-- ══════════════════════════════════════
task.spawn(function()
    local ultimateTimer = tick()
    while true do
        task.wait(0.01)
        if not _G.flag then continue end
        if not isTargetValid(_G.player) then continue end

        _G.striking = true
        spamSkills()

        -- G ulti mỗi 5s
        if tick() - ultimateTimer >= 5 then
            sendKey(true,  Enum.KeyCode.G) ; task.wait(0.02)
            sendKey(false, Enum.KeyCode.G)
            ultimateTimer = tick()
        end

        _G.striking = false
        task.wait(0.01)
    end
end)

