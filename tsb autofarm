    TpRange     = 15,      -- stud mới tp lại
    ComboDelay  = 0.09,
    RetreatHP   = 40,
    RetreatDist = 70,
    FinisherHP  = 25,
    UltCD       = 50,
    SkillCD     = 6,
    LagReduce   = true,
    AutoRespawn = true,
}

