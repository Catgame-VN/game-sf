-- Toggle buttons
local btnY = 102
local function addToggle(label, initState, cb)
    local btn         = Instance.new("TextButton")
    btn.Size          = UDim2.new(1, -16, 0, 36)
    btn.Position      = UDim2.new(0, 8, 0, btnY)
    btn.BackgroundColor3 = initState
        and Color3.fromRGB(35, 155, 65)
        or  Color3.fromRGB(85, 20, 20)
    btn.TextColor3    = Color3.new(1,1,1)
    btn.Text          = label .. ": " .. (initState and "ON" or "OFF")
    btn.Font          = Enum.Font.GothamSemibold
    btn.TextSize      = 13
    btn.AutoButtonColor = false
    btn.Parent        = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
    btnY = btnY + 40

    local state = initState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state
            and Color3.fromRGB(35, 155, 65)
            or  Color3.fromRGB(85, 20, 20)
        btn.Text = label .. ": " .. (state and "ON" or "OFF")
        cb(state)
    end)
end

