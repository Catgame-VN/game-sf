-- debug mode: thử từng format một cách chậm rãi rồi hiện lên GUI
local function debugFireAll(target)
    local comm = getComm(target.name)
    if not comm then
        dbgAdd("❌ Không tìm được Communicate!")
        return
    end
    dbgAdd("✅ Comm: " .. comm.Name .. " (" .. comm.ClassName .. ")")
    local tHRP = getHRP(target.char)
    if not tHRP then return end
    local pos  = tHRP.Position
    local char = target.char
    local hpBefore = getHPPct(target.char)
    
    -- thử tất cả M1 formats
    for _, fmt in ipairs(M1_FORMATS) do
        pcall(function() fmt.fn(comm, char, pos) end)
        task.wait(0.15)
        local hpAfter = getHPPct(target.char)
        if hpAfter < hpBefore - 0.5 then
            dbgAdd("🎯 DAMAGE! Format: " .. fmt.name)
            hpBefore = hpAfter
        end
    end
end

-- ============================================================
-- COMBAT THƯỜNG (non-debug) — fire tất cả formats
-- ============================================================
local function doM1(target)
    local comm = getComm(target.name)
    if not comm then return end
    local tHRP = getHRP(target.char)
    if not tHRP then return end
    local pos  = tHRP.Position
    local char = target.char
    for _, fmt in ipairs(M1_FORMATS) do
        pcall(function() fmt.fn(comm, char, pos) end)
    end
    -- trigger MoveTo để server detect collision
    local myHum = getHum(getChar())
    if myHum then pcall(function() myHum:MoveTo(pos) end) end
end

local function doSkill(target, idx)
    local comm = getComm(target.name)
    if not comm then return end
    local tHRP = getHRP(target.char)
    if not tHRP then return end
    local pos  = tHRP.Position
    local char = target.char
    for _, fmt in ipairs(SKILL_FORMATS) do
        pcall(function() fmt.fn(comm, char, pos, idx) end)
    end
end

local function doUlt(target)
    local comm = getComm(target.name)
    if not comm then return end
    local tHRP = getHRP(target.char)
    if not tHRP then return end
    local pos  = tHRP.Position
    local char = target.char
    for _, fmt in ipairs(ULT_FORMATS) do
        pcall(function() fmt.fn(comm, char, pos) end)
    end
end

-- ============================================================
-- TARGET
-- ============================================================
local function getBestTarget()
    local myHRP = getHRP(getChar())
    if not myHRP then return nil end
    local best, bestScore = nil, 999
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        if not char or not isAlive(char) then continue end
        local hrp = getHRP(char)
        if not hrp then continue end
        local d = getDist(myHRP, hrp)
        local score = d - (100 - getHPPct(char)) * 0.4
        if score < bestScore then
            bestScore = score
            best = {char=char, hrp=hrp, dist=d, hp=getHPPct(char), name=plr.Name}
        end
    end
    return best
end

-- ============================================================
-- TELEPORT — chỉ tp khi không đang đánh và dist > TpRange
-- ============================================================
local lastTp = 0
local function tpTo(hrp)
    if tick() - lastTp < 0.35 then return end
    local myHRP = getHRP(getChar())
    if not myHRP or not hrp then return end
    local dir = (myHRP.Position - hrp.Position).Unit
    myHRP.CFrame = CFrame.new(hrp.Position + dir * 4.5 + Vector3.new(0,1.5,0))
    lastTp = tick()
end

local function retreat()
    retreating = true
    isAttacking = false
    local myHRP = getHRP(getChar())
    if myHRP then
        local a = math.random() * math.pi * 2
        myHRP.CFrame = CFrame.new(myHRP.Position
            + Vector3.new(math.cos(a), 0, math.sin(a)) * CFG.RetreatDist)
    end
    task.wait(2.5)
    retreating = false
end

-- no-fly anchor
local function startAnchor(targetChar)
    if anchoredT[targetChar] then return end
    local tHRP = getHRP(targetChar)
    if not tHRP then return end
    anchoredT[targetChar] = true
    local groundY = tHRP.Position.Y
    task.spawn(function()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not anchoredT[targetChar] or not tHRP.Parent then
                conn:Disconnect(); anchoredT[targetChar]=nil; return
            end
            pcall(function()
                local vel = tHRP.AssemblyLinearVelocity
                if vel.Y > 4 then
                    tHRP.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                end
            end)
        end)
        task.wait(4)
        conn:Disconnect(); anchoredT[targetChar]=nil
    end)
end

-- ============================================================
-- MAIN LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(0.05)

        if not farming or retreating then
            isAttacking = false
            continue
        end

        local myChar = getChar()
        if not myChar or not isAlive(myChar) then
            isAttacking = false
            if CFG.AutoRespawn then
                pcall(function() LP:LoadCharacter() end)
                task.wait(3)
            end
            continue
        end

        local myHP = getHPPct(myChar)
        if myHP < CFG.RetreatHP then
            task.spawn(retreat)
            continue
        end

        local target = getBestTarget()
        if not target then
            isAttacking = false
            continue
        end

        local myHRP = getHRP(myChar)
        if not myHRP then continue end

        local dist = getDist(myHRP, target.hrp)

        -- tp chỉ khi xa và không đang đánh
        if dist > CFG.TpRange and not isAttacking then
            tpTo(target.hrp)
            task.wait(0.2)
            continue
        end

        -- trong range: đánh
        if dist <= CFG.TpRange then
            isAttacking = true

            -- xích lại gần hơn nếu cần
            if dist > CFG.AttackRange then
                tpTo(target.hrp)
                task.wait(0.1)
            end

            -- combat
            if CFG.Debug then
                task.spawn(function() debugFireAll(target) end)
                task.wait(2)
            else
                doM1(target)
                startAnchor(target.char)

                local now = tick()
                if now - lastSkill > CFG.SkillCD then
                    doSkill(target, 1)
                    task.wait(0.08)
                    doSkill(target, 2)
                    lastSkill = now
                end

                if now - lastUlt > CFG.UltCD then
                    doUlt(target)
                    lastUlt = now
                end
            end

            task.wait(CFG.ComboDelay)
        end
    end
end)

