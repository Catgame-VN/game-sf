-- =====================================================
-- COMBO ENGINE
-- =====================================================
local function doCombo(target)
    if comboCooldown then return end
    comboCooldown = true

    local targetChar = target.char
    local targetHRP  = target.hrp
    local isFinisher = target.hp < CFG.FinisherHP

    if CFG.HitAndFade then setNameplate(false) end

    -- Teleport gần
    teleportToTarget(targetHRP)
    task.wait(0.05)

    -- Face target
    local myHRP = getHRP(getChar())
    if myHRP then
        myHRP.CFrame = CFrame.lookAt(myHRP.Position, targetHRP.Position)
    end

    -- Bắt đầu anchor target (không cho bay)
    startAnchor(targetChar)

    if isFinisher then
        -- Finisher path: Q + M1 × 3 + ult nếu ready
        trySkill(1, targetChar)
        task.wait(0.15)
        for _ = 1, 3 do
            fireM1(targetChar)
            task.wait(CFG.M1Interval * 2)
        end
        if CFG.UseUlt and ultReady then
            trySkill(4, targetChar)
            lastUlt  = tick()
            ultReady = false
        end
    else
        -- Full combo: Q → M1 × 4 → E → M1 × 2 → R → M1 × 2 → ult?
        trySkill(1, targetChar)
        task.wait(0.15)

        for _ = 1, 4 do
            fireM1(targetChar)
            task.wait(CFG.M1Interval * 2)
        end

        trySkill(2, targetChar)
        task.wait(0.15)

        for _ = 1, 2 do
            fireM1(targetChar)
            task.wait(CFG.M1Interval * 2)
        end

        trySkill(3, targetChar)
        task.wait(0.15)

        for _ = 1, 2 do
            fireM1(targetChar)
            task.wait(CFG.M1Interval * 2)
        end

        if CFG.UseUlt and ultReady then
            trySkill(4, targetChar)
            lastUlt  = tick()
            ultReady = false
            task.wait(0.3)
        end
    end

    -- Hit & fade
    if CFG.HitAndFade then
        local myHRP2 = getHRP(getChar())
        if myHRP2 then
            myHRP2.CFrame = CFrame.new(
                myHRP2.Position + myHRP2.CFrame.LookVector * -10
            )
        end
        task.wait(0.2)
        setNameplate(true)
    end

    task.wait(0.35)
    comboCooldown = false
end

-- =====================================================
-- CONTINUOUS M1 LOOP (ngoài combo, khi đang gần target)
-- Spam M1 liên tục ngay cả khi không trong combo
-- =====================================================
task.spawn(function()
    while true do
        task.wait(CFG.M1Interval)
        if not farming or retreating or comboCooldown then continue end
        local char = getChar()
        if not char or not isAlive(char) then continue end
        local targets = getTargets()
        if #targets == 0 then continue end
        local best = targets[1]
        -- Chỉ M1 khi đã gần (< 8 studs)
        if best.dist < 8 then
            fireM1(best.char)
            startAnchor(best.char)
        end
    end
end)

-- =====================================================
-- MAIN LOOP
-- =====================================================
RunService.Heartbeat:Connect(function()
    if not farming then return end
    local char = getChar()
    if not char or not isAlive(char) then return end

    local hp = getHPPct(char)
    if hp < CFG.RetreatHP and not retreating then
        task.spawn(doRetreat)
        return
    end
    if retreating or comboCooldown then return end

    local now = tick()
    if (now - lastAttack) < CFG.AttackDelay then return end
    lastAttack = now

    local targets = getTargets()
    if #targets == 0 then return end

    task.spawn(function() doCombo(targets[1]) end)
end)

