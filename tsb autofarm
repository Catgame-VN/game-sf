local function refreshStatus()
    local remaining = HOP_INTERVAL - (tick() - hopStart)
    local pct = math.clamp(remaining / HOP_INTERVAL, 0, 1)

    statusText.Text = currentAction
    progressTime.Text = formatTime(remaining)
    progressFill.Size = UDim2.new(pct, 0, 1, 0)
    progressFill.BackgroundColor3 = pct < 0.1 and C.danger or C.accent

    local logText = #logLines > 0 and table.concat(logLines, "\n") or "(no log yet)"
    logLabel.Text = logText

    if currentAction:find("Hopping") or currentAction:find("dead") or currentAction:find("stuck") then
        statusDot.BackgroundColor3 = C.danger
        dotPulse.Color = C.danger
    elseif currentAction:find("Waiting") or currentAction:find("Cooldown") then
        statusDot.BackgroundColor3 = Color3.fromRGB(255, 200, 80)
        dotPulse.Color = Color3.fromRGB(255, 200, 80)
    else
        statusDot.BackgroundColor3 = C.success
        dotPulse.Color = C.success
    end
end

