if CFG.LagReduce then
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    local L = game:GetService("Lighting")
    L.GlobalShadows = false; L.FogEnd = 999999
    for _, v in ipairs(L:GetChildren()) do
        pcall(function()
            if v:IsA("BlurEffect") or v:IsA("SunRaysEffect")
            or v:IsA("ColorCorrectionEffect") then v.Enabled=false end
        end)
    end
    local function nuke(v)
        pcall(function()
            if LP.Character and v:IsDescendantOf(LP.Character) then return end
            if v:IsA("ParticleEmitter") then v.Rate=0; v.Enabled=false
            elseif v:IsA("Beam") or v:IsA("Trail") or v:IsA("Fire")
                or v:IsA("Smoke") or v:IsA("Sparkles") then v.Enabled=false
            elseif v:IsA("BasePart") then v.CastShadow=false end
        end)
    end
    for _, v in ipairs(workspace:GetDescendants()) do nuke(v) end
    workspace.DescendantAdded:Connect(nuke)
end

-- ============================================================
-- HELPERS
-- ============================================================
local function getChar() return LP.Character end
local function getHRP(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(c) return c and c:FindFirstChildWhichIsA("Humanoid") end
local function isAlive(c)
    local h = getHum(c)
    return h and h.Health > 0
end
local function getHPPct(c)
    local h = getHum(c)
    if not h or h.MaxHealth == 0 then return 0 end
    return (h.Health / h.MaxHealth) * 100
end
local function getDist(a, b)
    if not a or not b then return 999 end
    return (a.Position - b.Position).Magnitude
end

-- ============================================================
-- TÀNG HÌNH V8
-- 1. LocalTransparencyModifier = 1 (client-side ẩn với camera)
-- 2. Humanoid.DisplayDistanceType = None (ẩn nameplate)
-- 3. Humanoid.HealthDisplayType = None (ẩn HP bar)
-- LƯU Ý: tàng hình thật 100% với người khác cần server-side — 
--         client hack chỉ ẩn với local camera của mình
--         Cách tốt nhất là tránh bị seen = di chuyển nhanh, hit & run
-- ============================================================
local invisActive = true
local invisConn

local function applyInvis(char)
    if not char then return end
    -- ẩn parts
    for _, v in ipairs(char:GetDescendants()) do
        pcall(function()
            if v:IsA("BasePart") or v:IsA("MeshPart") then
                v.LocalTransparencyModifier = 1
            elseif v:IsA("Decal") then
                v.Transparency = 1
            elseif v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                v.Enabled = false
            end
        end)
    end
    -- ẩn nameplate + HP bar
    local hum = getHum(char)
    if hum then
        pcall(function()
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            hum.HealthDisplayType   = Enum.HumanoidHealthDisplayType.AlwaysOff
            hum.NameDisplayDistance = 0
            hum.HealthDisplayDistance = 0
        end)
    end
end

local function startInvis()
    local c = getChar()
    if c then applyInvis(c) end
    if invisConn then invisConn:Disconnect() end
    invisActive = true
    invisConn = RunService.Heartbeat:Connect(function()
        if not invisActive then invisConn:Disconnect(); return end
        local char = getChar()
        if not char then return end
        for _, v in ipairs(char:GetDescendants()) do
            pcall(function()
                if (v:IsA("BasePart") or v:IsA("MeshPart"))
                and v.LocalTransparencyModifier ~= 1 then
                    v.LocalTransparencyModifier = 1
                end
            end)
        end
    end)
end

local function stopInvis()
    invisActive = false
    if invisConn then invisConn:Disconnect() end
    local char = getChar()
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        pcall(function()
            if v:IsA("BasePart") or v:IsA("MeshPart") then
                v.LocalTransparencyModifier = 0
            elseif v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                v.Enabled = true
            end
        end)
    end
    local hum = getHum(char)
    if hum then
        pcall(function()
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Automatic
            hum.HealthDisplayType   = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
        end)
    end
end

LP.CharacterAdded:Connect(function()
    task.wait(0.5)
    if invisActive then startInvis() end
end)

task.spawn(function() task.wait(1); startInvis() end)

-- ============================================================
-- REMOTES — tìm Communicate trong workspace.Live
-- ============================================================
local commCache = {}
local function getComm(targetName)
    if commCache[targetName] then return commCache[targetName] end
    local live = workspace:FindFirstChild("Live")
    if not live then return nil end
    local folder = live:FindFirstChild(targetName)
    if not folder then return nil end
    -- tìm RemoteEvent bất kỳ trong folder
    local r = folder:FindFirstChild("Communicate")
        or folder:FindFirstChildWhichIsA("RemoteEvent")
        or folder:FindFirstChildWhichIsA("UnreliableRemoteEvent")
    if r then commCache[targetName] = r end
    return r
end

Players.PlayerRemoving:Connect(function(p) commCache[p.Name] = nil end)

