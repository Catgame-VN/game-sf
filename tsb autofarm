local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer
local folder = workspace:WaitForChild("HalloweenCandy")
local trees = workspace:WaitForChild("HalloweenDoorTrees")
local camera = workspace.CurrentCamera

local HOP_INTERVAL = 15 * 60
local SCRIPT_URL = "https://raw.githubusercontent.com/Catgame-VN/game-sf/refs/heads/main/tsb%20autof"
local MAX_LOG_LINES = 4

-- STATE
local currentAction = "Finding candy..."
local hopStart = tick()
local logLines = {}
local guiVisible = true

local function addLog(msg)
    local t = os.date("%H:%M:%S")
    table.insert(logLines, 1, "[" .. t .. "] " .. msg)
    while #logLines > MAX_LOG_LINES do
        table.remove(logLines)
    end
end

local function formatTime(sec)
    sec = math.max(0, math.floor(sec))
    local m = math.floor(sec / 60)
    local s = sec % 60
    return string.format("%02d:%02d", m, s)
end

-- ===== STATUS Drawing =====
local status = Drawing.new("Text")
status.Size = 18
status.Center = true
status.Outline = true
status.Color = Color3.fromRGB(255, 255, 255)
status.Position = Vector2.new(camera.ViewportSize.X / 2, 35)
status.Visible = true

local function refreshStatus()
    local remaining = HOP_INTERVAL - (tick() - hopStart)
    local text = "CatLazy Auto Candy"
        .. "\nStatus: " .. currentAction
        .. "\nNext hop: " .. formatTime(remaining)
    if #logLines > 0 then
        text = text .. "\n--- Log ---\n" .. table.concat(logLines, "\n")
    end
    status.Text = text
    status.Visible = guiVisible
end

game:GetService("RunService").RenderStepped:Connect(function()
    camera = workspace.CurrentCamera
    status.Position = Vector2.new(camera.ViewportSize.X / 2, 35)
    refreshStatus()
end)

