local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local found = {}

local function scan(parent, depth, path)
    if depth > 12 then return end
    local ok, children = pcall(function() return parent:GetChildren() end)
    if not ok then return end
    for _, v in ipairs(children) do
        local fullPath = path .. "." .. v.Name
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") or v:IsA("BindableEvent") then
            table.insert(found, string.format("[%s] %s", v.ClassName, fullPath))
        end
        if not v:IsA("BaseScript") and not v:IsA("ModuleScript") then
            scan(v, depth + 1, fullPath)
        end
    end
end

scan(RS, 0, "RS")
scan(game:GetService("Players"), 0, "Players")
scan(workspace, 0, "WS")

