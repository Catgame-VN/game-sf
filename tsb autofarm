local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

-- AUTO RE-EXEC SAU HOP
if queue_on_teleport then
    queue_on_teleport([[
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Catgame-VN/game-sf/refs/heads/main/tsb%20autofarm"))()
    ]])
end

local player = Players.LocalPlayer
local folder = workspace:WaitForChild("HalloweenCandy")
local trees = workspace:WaitForChild("HalloweenDoorTrees")
local camera = workspace.CurrentCamera

-- SETTINGS
local LOOP_DELAY = 0.15
local DOOR_WAIT_TIME = 3
local CANDY_HEIGHT = 4
local TREE_STAND_DISTANCE = 5
local HOP_INTERVAL = 15 * 60

-- STATUS
local status = Drawing.new("Text")
status.Text = "Discord: discord.gg/aBq4NTkMyP\nStatus: Finding candy..."
status.Size = 18
status.Center = true
status.Outline = true
status.Color = Color3.fromRGB(255, 255, 255)
status.Visible = true

RunService.RenderStepped:Connect(function()
    camera = workspace.CurrentCamera

    if camera then
        status.Position = Vector2.new(
            camera.ViewportSize.X / 2,
            35
        )
    end
end)

local function setStatus(message)
    status.Text = "Discord: discord.gg/aBq4NTkMyP\nStatus: " .. message
end

-- HOP SERVER
local function hopServer()
    setStatus("Hopping server...")

    local ok, servers = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet(
                "https://games.roblox.com/v1/games/"
                .. game.PlaceId
                .. "/servers/Public?sortOrder=Asc&limit=100"
            )
        )
    end)

    if ok and servers and servers.data then
        for _, s in ipairs(servers.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(
                        game.PlaceId, s.id, player
                    )
                end)
                return
            end
        end
    end

    pcall(function()
        TeleportService:Teleport(game.PlaceId, player)
    end)
end

local hopStart = tick()

-- STATE
local doorCooldownUntil = 0
local lastDoorPrompt = nil
local lastCandyPosition = nil

local function isBusy(character)
    return character:FindFirstChild("RootAnchor") ~= nil
        or character:FindFirstChild("NoRotate") ~= nil
end

-- GET CANDY POSITION
local function getCandyPosition(candy)
    local rest = candy:GetAttribute("Rest")

    if typeof(rest) == "CFrame" then
        return rest.Position
    elseif typeof(rest) == "Vector3" then
        return rest
    end

    return nil
end

-- FIND CLOSEST CANDY
local function findClosestCandy(root)
    local closestPosition = nil
    local closestDistance = math.huge

    for _, candy in ipairs(folder:GetChildren()) do
        local position = getCandyPosition(candy)

        if position then
            local distance = (root.Position - position).Magnitude

            if distance < closestDistance then
                closestDistance = distance
                closestPosition = position
            end
        end
    end

    return closestPosition
end

-- FIND CLOSEST DOOR
local function findClosestDoor(root, ignoredPrompt)
    local closestPrompt = nil
    local closestPart = nil
    local closestTree = nil
    local closestDistance = math.huge

    for _, tree in ipairs(trees:GetChildren()) do
        local door = tree:FindFirstChild("DOOR 1 NEW")
        local frame = door and door:FindFirstChild("Frame")
        local prompt = frame and frame:FindFirstChild("TrickOrTreat")

        if prompt
            and prompt:IsA("ProximityPrompt")
            and prompt.Enabled
            and prompt ~= ignoredPrompt then

            local parent = prompt.Parent
            local part = parent

            if parent and parent:IsA("Attachment") then
                part = parent.Parent
            end

            if part and part:IsA("BasePart") then
                local distance = (root.Position - part.Position).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closestPrompt = prompt
                    closestPart = part
                    closestTree = tree
                end
            end
        end
    end

    return closestPrompt, closestPart, closestTree
end

-- GET POSITION UNDER TREE
local function getDoorPosition(tree, part, root, humanoid)
    local boxCFrame
    local boxSize

    if tree:IsA("Model") then
        boxCFrame, boxSize = tree:GetBoundingBox()
    elseif tree:IsA("BasePart") then
        boxCFrame = tree.CFrame
        boxSize = tree.Size
    else
        return part.Position + Vector3.new(0, 3, 0)
    end

    local center = boxCFrame.Position

    local direction = Vector3.new(
        part.Position.X - center.X,
        0,
        part.Position.Z - center.Z
    )

    if direction.Magnitude < 0.1 then
        direction = Vector3.new(0, 0, 1)
    end

    direction = direction.Unit

    local doorDistance = Vector3.new(
        part.Position.X - center.X,
        0,
        part.Position.Z - center.Z
    ).Magnitude

    local standDistance = math.max(
        TREE_STAND_DISTANCE,
        doorDistance + 2
    )

    local position = center + direction * standDistance

    local groundY = boxCFrame.Position.Y - boxSize.Y / 2

    local height = humanoid.HipHeight + root.Size.Y / 2

    position = Vector3.new(
        position.X,
        groundY + height + 0.25,
        position.Z
    )

    return CFrame.lookAt(
        position,
        Vector3.new(part.Position.X, position.Y, part.Position.Z)
    )
end

-- MAIN LOOP
while task.wait(LOOP_DELAY) do
    if tick() - hopStart >= HOP_INTERVAL then
        hopServer()
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid then
        setStatus("Waiting for character...")
        continue
    end

    if humanoid.Health <= 0 then
        setStatus("Character dead...")
        lastCandyPosition = nil
        continue
    end

    if isBusy(character) then
        setStatus("Knocking on door...")
        continue
    end

    if os.clock() < doorCooldownUntil then
        local remaining = math.ceil(doorCooldownUntil - os.clock())

        setStatus("Waiting after knocking... " .. remaining .. "s")
        continue
    end

    local closestCandy = findClosestCandy(root)

    if closestCandy then
        setStatus("Collecting candy...")

        local sameCandy = lastCandyPosition
            and (lastCandyPosition - closestCandy).Magnitude < 1

        if not sameCandy or (root.Position - closestCandy).Magnitude > 8 then
            root.CFrame = CFrame.new(
                closestCandy + Vector3.new(0, CANDY_HEIGHT, 0)
            )

            root.AssemblyLinearVelocity = Vector3.zero

            lastCandyPosition = closestCandy
        end

        continue
    end

    lastCandyPosition = nil

    local prompt, part, tree = findClosestDoor(root, lastDoorPrompt)

    if not prompt then
        prompt, part, tree = findClosestDoor(root, nil)
    end

    if prompt and part and tree then
        setStatus("Visiting next door...")

        local targetCFrame = getDoorPosition(
            tree,
            part,
            root,
            humanoid
        )

        root.CFrame = targetCFrame
        root.AssemblyLinearVelocity = Vector3.zero

        task.wait(0.2)

        if humanoid.Health > 0
            and not isBusy(character)
            and prompt.Parent
            and prompt.Enabled then

            local success = pcall(function()
                fireproximityprompt(prompt)
            end)

            if success then
                lastDoorPrompt = prompt
                doorCooldownUntil = os.clock() + DOOR_WAIT_TIME

                setStatus("Door knocked! Waiting 3 seconds...")
            else
                setStatus("Door interaction failed...")
            end
        end
    else
        setStatus("No candy - No doors found")
    end
end
