-- SETTINGS
local LOOP_DELAY = 0.15
local DOOR_WAIT_TIME = 3
local CANDY_HEIGHT = 4
local TREE_STAND_DISTANCE = 5
local HOP_INTERVAL = 15 * 60

-- DOOR FIRE SETTINGS
local DOOR_POST_TP_WAIT = 0.45
local DOOR_FIRE_RETRIES = 4
local DOOR_FIRE_GAP = 0.2
local DOOR_BUSY_WAIT = 1.5
local CAM_AIM_WAIT = 0.15

-- NO-DOOR HOP
local NO_DOOR_HOP_TIME = 3

local SCRIPT_URL = "https://raw.githubusercontent.com/Catgame-VN/game-sf/refs/heads/main/tsb%20autofarm"

