local function createToggle(text, yOffset, default, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 35)
    btn.Position = UDim2.fromOffset(10, yOffset)
    btn.BackgroundColor3 = default and Color3.fromRGB(35, 155, 85) or Color3.fromRGB(55, 55, 70)
    btn.Text = text .. (default and ": ON" or ": OFF")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = f
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. (state and ": ON" or ": OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(35, 155, 85) or Color3.fromRGB(55, 55, 70)
        callback(state)
    end)
end

createToggle("Auto Farm", 40, false, function(s) CONFIG.auto_farm = s end)
createToggle("Tàng Hình (Invisible)", 85, true, function(s) 
    CONFIG.invisible = s
    setInvisibility(s)
end)
createToggle("Kill Aura", 130, true, function(s) CONFIG.kill_aura = s end)
createToggle("Auto Dodge", 175, true, function(s) CONFIG.auto_dodge = s end)

log("loaded. Bật Auto Farm và Tàng Hình để chạy.")
