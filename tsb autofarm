-- per-player Communicate — tìm trong workspace.Live
local function getCommRemote(targetName)
    local ok, r = pcall(function()
        return workspace:WaitForChild("Live", 2)
            :WaitForChild(targetName, 2)
            :WaitForChild("Communicate", 2)
    end)
    if ok and r then return r end
    -- fallback: scan trực tiếp
    local live = workspace:FindFirstChild("Live")
    if live then
        local folder = live:FindFirstChild(targetName)
        if folder then
            return folder:FindFirstChild("Communicate")
        end
    end
    return nil
end

-- ============================================================
-- TÀNG HÌNH
-- ============================================================
local function applyInvis(char)
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        pcall(function()
            if v:IsA("BasePart") or v:IsA("MeshPart") then
                v.Transparency = 1
                v.CastShadow   = false
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = 1
            elseif v:IsA("BillboardGui") then
                v.Enabled = false
            end
        end)
    end
end

local invisConn
local function startInvis()
    local char = LP.Character
    if char then applyInvis(char) end
    if invisConn then invisConn:Disconnect() end
    invisConn = RunService.Heartbeat:Connect(function()
        if not CFG.Invisible then
            invisConn:Disconnect(); return
        end
        local c = LP.Character
        if not c then return end
        local head = c:FindFirstChild("Head")
        if head and head.Transparency ~= 1 then
            applyInvis(c)
        end
    end)
end

local function stopInvis()
    if invisConn then invisConn:Disconnect() end
    local char = LP.Character
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        pcall(function()
            if v:IsA("BasePart") or v:IsA("MeshPart") then
                v.Transparency = 0
            elseif v:IsA("BillboardGui") then
                v.Enabled = true
            end
        end)
    end
end

LP.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if CFG.Invisible then applyInvis(char) end
end)

task.spawn(function()
    task.wait(1)
    if CFG.Invisible then startInvis() end
end)

-- ============================================================
-- HELPERS
-- ============================================================
local function getChar() return LP.Character end
local function getHRP(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function getHum(char)
    return char and char:FindFirstChildWhichIsA("Humanoid")
end
local function isAlive(char)
    local h = getHum(char)
    return h and h.Health > 0
end
local function getHPPct(char)
    local h = getHum(char)
    if not h then return 0 end
    return (h.Health / h.MaxHealth) * 100
end

-- ============================================================
-- TARGET SELECTION — tự động, không nhập tên
-- ============================================================
local function getTargets()
    local myChar = getChar()
    local myHRP  = getHRP(myChar)
    if not myHRP then return {} end
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        if not char or not isAlive(char) then continue end
        local hrp = getHRP(char)
        if not hrp then continue end
        local dist = (hrp.Position - myHRP.Position).Magnitude
        local hp   = getHPPct(char)
        table.insert(list, {char=char, hrp=hrp, dist=dist, hp=hp, name=plr.Name, plr=plr})
    end
    table.sort(list, function(a, b)
        if a.hp < CFG.FinisherHP and b.hp >= CFG.FinisherHP then return true end
        if b.hp < CFG.FinisherHP and a.hp >= CFG.FinisherHP then return false end
        return a.dist < b.dist
    end)
    return list
end

-- ============================================================
-- TELEPORT
-- ============================================================
local function tpBehind(targetHRP)
    local myHRP = getHRP(getChar())
    if not myHRP or not targetHRP then return end
    local dir = (myHRP.Position - targetHRP.Position).Unit
    myHRP.CFrame = CFrame.new(targetHRP.Position + dir * 3 + Vector3.new(0, 1, 0))
end

local function fadeAway(fromPos)
    local myHRP = getHRP(getChar())
    if not myHRP then return end
    local a = math.random() * math.pi * 2
    local r = CFG.FadeRange * (0.5 + math.random() * 0.5)
    myHRP.CFrame = CFrame.new(fromPos + Vector3.new(math.cos(a)*r, 0, math.sin(a)*r))
end

local function retreat()
    retreating = true
    local myHRP = getHRP(getChar())
    if myHRP then
        local a = math.random() * math.pi * 2
        myHRP.CFrame = CFrame.new(myHRP.Position
            + Vector3.new(math.cos(a), 0, math.sin(a)) * CFG.RetreatDist)
    end
    task.wait(3)
    retreating = false
end

-- ============================================================
-- NO-FLY ANCHOR
-- ============================================================
local function startAnchor(targetChar)
    if not CFG.NoFlyAnchor or anchoredTargets[targetChar] then return end
    local tHRP = getHRP(targetChar)
    if not tHRP then return end
    local groundY = tHRP.Position.Y
    anchoredTargets[targetChar] = true
    task.spawn(function()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not anchoredTargets[targetChar] or not isAlive(targetChar) or not tHRP.Parent then
                conn:Disconnect(); anchoredTargets[targetChar] = nil; return
            end
            pcall(function()
                local vel = tHRP.AssemblyLinearVelocity
                if vel.Y > 5 then
                    tHRP.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                end
                if tHRP.Position.Y > groundY + 8 then
                    tHRP.CFrame = CFrame.new(tHRP.Position.X, groundY+1, tHRP.Position.Z)
                end
            end)
        end)
        task.wait(4)
        conn:Disconnect()
        anchoredTargets[targetChar] = nil
    end)
end

-- ============================================================
-- FIRE COMBAT
-- TSB Communicate args format (reverse-engineered từ open-source leaks):
--   M1:    remote:FireServer("Attack", targetHRP.Position, targetHRP)
--   Skill: remote:FireServer("Skill", skillIndex, targetHRP.Position)
--   Ult:   remote:FireServer("Ultimate", targetHRP.Position)
-- Thử nhiều format vì game update thường xuyên
-- ============================================================
local function fireAttack(commRemote, targetChar, action, skillIdx)
    if not commRemote then return end
    local tHRP = getHRP(targetChar)
    local pos  = tHRP and tHRP.Position or Vector3.new(0,0,0)

    -- format 1: (action, pos, hrp)
    pcall(function() commRemote:FireServer(action, pos, tHRP) end)
    -- format 2: (action, hrp)
    pcall(function() commRemote:FireServer(action, tHRP) end)
    -- format 3: (action, pos)
    pcall(function() commRemote:FireServer(action, pos) end)
    -- format 4: (action, skillIdx, pos) — cho skill
    if skillIdx then
        pcall(function() commRemote:FireServer(action, skillIdx, pos) end)
        pcall(function() commRemote:FireServer(action, skillIdx, tHRP) end)
    end
    -- format 5: bare action
    pcall(function() commRemote:FireServer(action) end)

    -- also ping Replication remote (TSB sync)
    if replicationRemote then
        pcall(function() replicationRemote:FireServer(action, tHRP) end)
    end

    -- MoveTo để trigger server hitbox
    local myHum = getHum(getChar())
    if myHum and tHRP then
        pcall(function() myHum:MoveTo(pos) end)
    end
end

local function doM1(commRemote, targetChar)
    -- TSB M1 action strings
    for _, act in ipairs({"Attack", "M1", "Punch", "BasicAttack", "Hit", "Melee"}) do
        fireAttack(commRemote, targetChar, act, nil)
    end
end

local function doSkill(commRemote, targetChar, idx)
    idx = idx or 1
    for _, act in ipairs({"Skill", "UseSkill", "Q", "E", "Ability"}) do
        fireAttack(commRemote, targetChar, act, idx)
    end
end

local function doUlt(commRemote, targetChar)
    for _, act in ipairs({"Ultimate", "Ult", "R", "UltimateSkill", "Super"}) do
        fireAttack(commRemote, targetChar, act, nil)
    end
end

-- ============================================================
-- COMBO ENGINE
-- ============================================================
local function doCombo(target)
    if comboCooldown then return end
    comboCooldown = true

    local comm = getCommRemote(target.name)
    local attackPos = target.hrp and target.hrp.Position or Vector3.new(0,0,0)

    tpBehind(target.hrp)
    startAnchor(target.char)

    local now = tick()

    if target.hp < CFG.FinisherHP then
        -- FINISHER: M1 → skill1 → ult
        for _ = 1, 3 do
            if not isAlive(target.char) then break end
            doM1(comm, target.char)
            task.wait(CFG.ComboDelay)
        end
        if now - lastSkill > CFG.SkillCD then
            doSkill(comm, target.char, 1)
            task.wait(0.2)
            doSkill(comm, target.char, 2)
            lastSkill = now
            task.wait(0.3)
        end
        if now - lastUlt > CFG.UltCD then
            doUlt(comm, target.char)
            lastUlt = now
        end
    else
        -- NORMAL: 5×M1 + skill
        for i = 1, 5 do
            if not isAlive(target.char) then break end
            doM1(comm, target.char)
            task.wait(CFG.ComboDelay)
        end
        if now - lastSkill > CFG.SkillCD then
            doSkill(comm, target.char, 1)
            lastSkill = now
            task.wait(0.2)
        end
    end

    fadeAway(attackPos)
    task.wait(0.3)
    comboCooldown = false
end

-- ============================================================
-- ULT AUTO LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(1)
        if not farming then continue end
        local now = tick()
        if now - lastUlt < CFG.UltCD then continue end
        if not isAlive(getChar()) then continue end
        local targets = getTargets()
        if #targets > 0 and targets[1].dist < 20 then
            local comm = getCommRemote(targets[1].name)
            doUlt(comm, targets[1].char)
            lastUlt = now
        end
    end
end)

-- ============================================================
-- CONTINUOUS M1 LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(CFG.M1Interval)
        if not farming or retreating or comboCooldown then continue end
        if not isAlive(getChar()) then continue end
        local targets = getTargets()
        if #targets == 0 then continue end
        local t = targets[1]
        if t.dist < 8 then
            local comm = getCommRemote(t.name)
            doM1(comm, t.char)
            startAnchor(t.char)
        end
    end
end)

-- ============================================================
-- MAIN LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(0.2)
        if not farming then continue end
        local myChar = getChar()
        if not myChar or not isAlive(myChar) then
            if CFG.AutoRespawn then
                pcall(function() LP:LoadCharacter() end)
                task.wait(3)
            end
            continue
        end
        if getHPPct(myChar) < CFG.RetreatHP and not retreating then
            task.spawn(retreat); continue
        end
        if retreating then continue end
        local targets = getTargets()
        if #targets == 0 then continue end
        local best = targets[1]
        if best.dist > CFG.AttackRange then
            tpBehind(best.hrp)
            task.wait(0.1)
        else
            task.spawn(function() doCombo(best) end)
            task.wait(CFG.ComboDelay * 5)
        end
    end
end)

