-- ===== HOP =====
local function hopServer(reason)
    setStatus("Hopping server...")
    addLog("Hop: " .. (reason or "manual"))

    if webhookUrl ~= "" then
        sendWebhook(
            "Server Hop",
            "**Reason:** " .. (reason or "manual") ..
            "\n**Candy collected:** " .. candyCollected ..
            "\n**Doors knocked:** " .. doorsKnocked ..
            "\n**Last door candy:** " .. lastDoorCandy ..
            "\n**Session time:** " .. formatTime(tick() - hopStart),
            0x78c8ff
        )
    end

    if queue_on_teleport then
        queue_on_teleport([[
            loadstring(game:HttpGet("]] .. SCRIPT_URL .. [[", true))()
        ]])
    end

    local ok, servers = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet(
                "https://games.roblox.com/v1/games/"
                .. game.PlaceId
                .. "/servers/Public?sortOrder=Asc&limit=100"
            )
        )
    end)

    if ok and servers and servers.data then
        local total = 0
        for _ in ipairs(servers.data) do total = total + 1 end
        addLog("Found " .. total .. " servers")

        for _, s in ipairs(servers.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                addLog(s.playing .. "/" .. s.maxPlayers .. " -> teleport")
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, player)
                end)
                return
            end
        end
        addLog("All full - rejoin")
    else
        addLog("Fetch failed - rejoin")
    end

    pcall(function()
        TeleportService:Teleport(game.PlaceId, player)
    end)
end

local function isBusy(character)
    return character:FindFirstChild("RootAnchor") or
        character:FindFirstChild("NoRotate")
end

local function findClosestDoor(root)
    local closestPrompt
    local closestPart
    local closestDistance = math.huge

    for _, tree in ipairs(trees:GetChildren()) do
        local door = tree:FindFirstChild("DOOR 1 NEW")
        local frame = door and door:FindFirstChild("Frame")
        local prompt = frame and frame:FindFirstChild("TrickOrTreat")

        if prompt and prompt:IsA("ProximityPrompt") then
            local part = prompt.Parent

            if part and part:IsA("BasePart") then
                local distance = (root.Position - part.Position).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closestPrompt = prompt
                    closestPart = part
                end
            end
        end
    end

    return closestPrompt, closestPart
end

-- ===== AIM CAMERA =====
local function aimCameraAt(part)
    local cam = workspace.CurrentCamera
    if not cam or not part then return nil end
    local saved = {
        type = cam.CameraType,
        subject = cam.CameraSubject,
        cframe = cam.CFrame,
    }
    pcall(function()
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, part.Position)
    end)
    return saved
end

local function restoreCamera(saved)
    local cam = workspace.CurrentCamera
    if not cam or not saved then return end
    pcall(function()
        cam.CameraType = saved.type
        cam.CameraSubject = saved.subject
        cam.CFrame = saved.cframe
    end)
end

-- ===== KNOCK DOOR =====
local function knockDoor(prompt, part, character, root, humanoid)
    if doorsKnocked > 0 then
        lastDoorCandy = candySinceLastDoor
        addLog("Prev door: +" .. lastDoorCandy .. " candy")
    else
        lastDoorCandy = 0
    end
    candySinceLastDoor = 0

    pcall(function()
        local doorPos = part.Position
        local standPos = doorPos + (doorPos - root.Position).Unit * 5 + Vector3.new(0, 3, 0)
        root.CFrame = CFrame.lookAt(standPos, doorPos)
    end)
    root.AssemblyLinearVelocity = Vector3.zero

    task.wait(0.25)

    local savedCam = aimCameraAt(part)
    task.wait(0.08)
    aimCameraAt(part)

    setStatus("Knocking door...")

    local ok = pcall(function()
        fireproximityprompt(prompt)
    end)

    if ok then
        doorsKnocked = doorsKnocked + 1

        local waited = 0
        while waited < 1.5 do
            task.wait(0.1)
            waited = waited + 0.1
            if isBusy(character) then break end
        end

        if WEBHOOK_DOOR_NOTIFY and webhookUrl ~= "" then
            sendWebhook(
                "Door Knocked",
                "**Door #:** " .. doorsKnocked ..
                "\n**Candy since last door:** +" .. lastDoorCandy ..
                "\n**Candy total:** " .. candyCollected ..
                "\n**Session time:** " .. formatTime(tick() - hopStart),
                0xf0c060
            )
        end
    else
        addLog("Fire failed")
    end

    restoreCamera(savedCam)

    return ok
end

addLog("Loaded - hop every 10m")

while task.wait() do
    if tick() - hopStart >= HOP_INTERVAL then
        hopServer("10m timer")
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid then
        setStatus("Waiting for character...")
        continue
    end

    if humanoid.Health <= 0 then
        setStatus("Character dead...")
        continue
    end

    if isBusy(character) then
        setStatus("Door...")
        continue
    end

    local closestCandy
    local closestDistance = math.huge

    for _, candy in ipairs(folder:GetChildren()) do
        local rest = candy:GetAttribute("Rest")

        if rest then
            local distance = (root.Position - rest.Position).Magnitude

            if distance < closestDistance then
                closestDistance = distance
                closestCandy = rest
            end
        end
    end

    if closestCandy then
        if closestCandy ~= lastCandyRef then
            candyCollected = candyCollected + 1
            candySinceLastDoor = candySinceLastDoor + 1
            lastCandyRef = closestCandy
        end
        setStatus("Collecting candy...")
        root.CFrame = CFrame.new(closestCandy.Position + Vector3.new(0, 4, 0))
        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    else
        lastCandyRef = nil
        local prompt, part = findClosestDoor(root)

        if prompt and part then
            setStatus("Visiting door...")
            knockDoor(prompt, part, character, root, humanoid)
        else
            setStatus("No candy - no doors")
            root.CFrame = CFrame.new(0, 100, 0)
        end
    end
end
