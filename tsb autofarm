-- ============================================================
-- NUCLEAR LAG REDUCE
-- ============================================================
if CFG.LagReduce then
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    local L = game:GetService("Lighting")
    L.GlobalShadows = false; L.FogEnd = 999999
    pcall(function()
        for _, v in ipairs(L:GetChildren()) do
            if v:IsA("BlurEffect") or v:IsA("SunRaysEffect")
            or v:IsA("ColorCorrectionEffect") then v.Enabled=false end
        end
    end)
    local function nuke(v)
        pcall(function()
            if LP.Character and v:IsDescendantOf(LP.Character) then return end
            if v:IsA("ParticleEmitter") then v.Rate=0; v.Enabled=false
            elseif v:IsA("Beam") or v:IsA("Trail") or v:IsA("Fire")
                or v:IsA("Smoke") or v:IsA("Sparkles") then v.Enabled=false
            elseif v:IsA("Decal") or v:IsA("Texture") then v.Transparency=1
            elseif v:IsA("PointLight") or v:IsA("SpotLight")
                or v:IsA("SurfaceLight") then v.Enabled=false
            elseif v:IsA("BasePart") then v.CastShadow=false end
        end)
    end
    for _, v in ipairs(workspace:GetDescendants()) do nuke(v) end
    workspace.DescendantAdded:Connect(nuke)
end

-- ============================================================
-- TÀNG HÌNH THẬT — hook LocalTransparencyModifier
-- TSB set LocalTransparencyModifier trên mỗi part để control visibility
-- Override bằng cách set property này về 1 liên tục
-- ============================================================
local invisActive = true
local invisConn

local function applyInvis(char)
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        pcall(function()
            if v:IsA("BasePart") or v:IsA("MeshPart") then
                v.LocalTransparencyModifier = 1
            end
        end)
    end
    -- ẩn nameplate/billboard
    for _, v in ipairs(char:GetDescendants()) do
        pcall(function()
            if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                v.Enabled = false
            end
        end)
    end
end

local function startInvis()
    local char = LP.Character
    if char then applyInvis(char) end
    if invisConn then invisConn:Disconnect() end
    invisConn = RunService.Heartbeat:Connect(function()
        if not invisActive then invisConn:Disconnect(); return end
        local c = LP.Character
        if not c then return end
        pcall(function()
            for _, v in ipairs(c:GetDescendants()) do
                if (v:IsA("BasePart") or v:IsA("MeshPart"))
                and v.LocalTransparencyModifier ~= 1 then
                    v.LocalTransparencyModifier = 1
                end
            end
        end)
    end)
end

local function stopInvis()
    invisActive = false
    if invisConn then invisConn:Disconnect() end
    local char = LP.Character
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        pcall(function()
            if v:IsA("BasePart") or v:IsA("MeshPart") then
                v.LocalTransparencyModifier = 0
            end
        end)
    end
    -- restore billboards
    for _, v in ipairs(char:GetDescendants()) do
        pcall(function()
            if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                v.Enabled = true
            end
        end)
    end
end

LP.CharacterAdded:Connect(function(char)
    task.wait(0.3)
    if invisActive then
        invisActive = true
        startInvis()
    end
end)

task.spawn(function()
    task.wait(1)
    startInvis()
end)

-- ============================================================
-- REMOTES
-- ============================================================
local commCache = {}
local function getComm(targetName)
    if commCache[targetName] then return commCache[targetName] end
    local live = workspace:FindFirstChild("Live")
    if not live then return nil end
    local folder = live:FindFirstChild(targetName)
    if not folder then return nil end
    local r = folder:FindFirstChild("Communicate")
    if r then commCache[targetName] = r end
    return r
end

-- clear cache khi player leave
Players.PlayerRemoving:Connect(function(plr)
    commCache[plr.Name] = nil
end)

-- ============================================================
-- HELPERS
-- ============================================================
local function getChar() return LP.Character end
local function getHRP(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function getHum(char)
    return char and char:FindFirstChildWhichIsA("Humanoid")
end
local function isAlive(char)
    local h = getHum(char)
    return h and h.Health > 0
end
local function getHPPct(char)
    local h = getHum(char)
    if not h or h.MaxHealth == 0 then return 0 end
    return (h.Health / h.MaxHealth) * 100
end
local function getDist(a, b)
    if not a or not b then return 999 end
    return (a.Position - b.Position).Magnitude
end

-- ============================================================
-- TARGET — chọn target gần nhất còn sống
-- ============================================================
local function getBestTarget()
    local myHRP = getHRP(getChar())
    if not myHRP then return nil end
    local best, bestDist = nil, 999
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        if not char or not isAlive(char) then continue end
        local hrp = getHRP(char)
        if not hrp then continue end
        local d = getDist(myHRP, hrp)
        -- ưu tiên HP thấp
        local score = d - (100 - getHPPct(char)) * 0.5
        if score < bestDist then
            bestDist = score
            best = {char=char, hrp=hrp, dist=d, hp=getHPPct(char), name=plr.Name}
        end
    end
    return best
end

-- ============================================================
-- TELEPORT — chỉ tp khi thực sự cần
-- ============================================================
local lastTp = 0
local function tpToTarget(hrp)
    if tick() - lastTp < 0.3 then return end -- rate limit tp
    local myHRP = getHRP(getChar())
    if not myHRP or not hrp then return end
    local dir = (myHRP.Position - hrp.Position).Unit
    myHRP.CFrame = CFrame.new(hrp.Position + dir * 4 + Vector3.new(0, 1.5, 0))
    lastTp = tick()
end

local function retreat()
    retreating = true
    local myHRP = getHRP(getChar())
    if myHRP then
        local a = math.random() * math.pi * 2
        myHRP.CFrame = CFrame.new(myHRP.Position
            + Vector3.new(math.cos(a), 0, math.sin(a)) * CFG.RetreatDist)
    end
    task.wait(2.5)
    retreating = false
end

-- ============================================================
-- NO-FLY ANCHOR
-- ============================================================
local function startAnchor(targetChar)
    if anchoredTargets[targetChar] then return end
    local tHRP = getHRP(targetChar)
    if not tHRP then return end
    local groundY = tHRP.Position.Y
    anchoredTargets[targetChar] = true
    task.spawn(function()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not anchoredTargets[targetChar] or not isAlive(targetChar) or not tHRP.Parent then
                conn:Disconnect(); anchoredTargets[targetChar]=nil; return
            end
            pcall(function()
                local vel = tHRP.AssemblyLinearVelocity
                if vel.Y > 4 then
                    tHRP.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                end
                if tHRP.Position.Y > groundY + 7 then
                    tHRP.CFrame = CFrame.new(tHRP.Position.X, groundY+1, tHRP.Position.Z)
                end
            end)
        end)
        task.wait(5)
        conn:Disconnect(); anchoredTargets[targetChar]=nil
    end)
end

-- ============================================================
-- FIRE COMBAT — multi-format cho Communicate remote
-- ============================================================
-- TSB Communicate format (từ community decompile):
-- M1:    FireServer("Attack", charRef, hrpPos, hitboxSize)
-- Skill: FireServer("Skill", skillNum, charRef, hrpPos)  
-- Ult:   FireServer("Ultimate", charRef, hrpPos)
local function fireComm(comm, target, action, extra)
    if not comm then return end
    local tHRP = getHRP(target.char)
    local pos = tHRP and tHRP.Position or Vector3.new(0,0,0)
    local char = target.char

    -- format chính (TSB decompile)
    pcall(function() comm:FireServer(action, char, pos, Vector3.new(5,5,5)) end)
    pcall(function() comm:FireServer(action, char, pos) end)
    pcall(function() comm:FireServer(action, pos, char) end)

    if extra then -- skill number
        pcall(function() comm:FireServer(action, extra, char, pos) end)
        pcall(function() comm:FireServer(action, extra, pos) end)
    end

    -- fallback formats
    pcall(function() comm:FireServer(action, tHRP) end)
    pcall(function() comm:FireServer(action) end)

    -- MoveTo trigger hitbox server-side
    local myHum = getHum(getChar())
    if myHum then pcall(function() myHum:MoveTo(pos) end) end
end

local function doM1(target)
    local comm = getComm(target.name)
    for _, act in ipairs({"Attack", "M1", "Punch", "BasicAttack"}) do
        fireComm(comm, target, act, nil)
    end
end

local function doSkill(target, idx)
    local comm = getComm(target.name)
    for _, act in ipairs({"Skill", "UseSkill", "Ability"}) do
        fireComm(comm, target, act, idx)
    end
end

local function doUlt(target)
    local comm = getComm(target.name)
    for _, act in ipairs({"Ultimate", "Ult", "Super"}) do
        fireComm(comm, target, act, nil)
    end
end

-- ============================================================
-- MAIN ATTACK LOOP — một loop duy nhất, không bị interrupt
-- ============================================================
task.spawn(function()
    while true do
        task.wait(0.05) -- 20 ticks/s check

        if not farming or retreating then continue end

        local myChar = getChar()
        if not myChar or not isAlive(myChar) then
            if CFG.AutoRespawn then
                pcall(function() LP:LoadCharacter() end)
                task.wait(3)
            end
            continue
        end

        -- retreat khi máu thấp
        local myHP = getHPPct(myChar)
        if myHP < CFG.RetreatHP and not retreating then
            task.spawn(retreat)
            continue
        end

        local target = getBestTarget()
        if not target then continue end

        local myHRP = getHRP(myChar)
        if not myHRP then continue end

        local dist = getDist(myHRP, target.hrp)

        -- tp nếu quá xa
        if dist > CFG.TpRange then
            tpToTarget(target.hrp)
            task.wait(0.15)
            continue
        end

        -- trong range: đánh liên tục
        if dist > CFG.AttackRange then
            tpToTarget(target.hrp)
        end

        -- M1 liên tục
        doM1(target)
        startAnchor(target.char)

        -- skill nếu off cooldown
        local now = tick()
        if now - lastSkill > CFG.SkillCD then
            doSkill(target, 1)
            task.wait(0.1)
            doSkill(target, 2)
            lastSkill = now
        end

        -- ult nếu off cooldown
        if now - lastUlt > CFG.UltCD then
            doUlt(target)
            lastUlt = now
        end

        task.wait(CFG.ComboDelay)
    end
end)

