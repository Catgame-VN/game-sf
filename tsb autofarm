-- CONFIG
-- =====================================================
local CFG = {
    AutoFarm         = true,
    UseUlt           = true,
    HitAndFade       = true,
    RetreatHP        = 45,       -- % HP để retreat
    FinisherHP       = 30,       -- % HP của TARGET để trigger finisher
    FarmRange        = 55,
    RetreatRange     = 80,
    AttackDelay      = 0.12,
    ComboCount       = 4,
    AntiAFK          = true,
    AvoidUltUsers    = true,

    UltKey    = Enum.KeyCode.F,
    ComboKey  = Enum.KeyCode.Z,  -- fixed typo
    SkillKeys = {
        Enum.KeyCode.Q,          -- Skill 1 — Incinerate (finisher candidate)
        Enum.KeyCode.E,          -- Skill 2 — Blaster
        Enum.KeyCode.R,          -- Skill 3 — Arm Cannon
    },
    -- Skill dùng để finisher: Q (skill 1) hoặc F (ult) tùy HP target
    FinisherSkill1 = Enum.KeyCode.Q,  -- dùng khi target HP < 30%
    FinisherSkill2 = Enum.KeyCode.F,  -- dùng ult nếu ready + target HP < 30%
}

-- =====================================================
-- STATE
-- =====================================================
local farming       = CFG.AutoFarm
local retreating    = false
local lastAttack    = 0
local lastUlt       = 0
local ultReady      = false
local ULT_CD        = 55
local comboCooldown = false

-- =====================================================
-- HELPERS
-- =====================================================
local function getChar() return LP.Character end
local function getHRP(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(c) return c and c:FindFirstChildWhichIsA("Humanoid") end

local function getHPPct(char)
    local hum = getHum(char)
    if not hum or hum.MaxHealth == 0 then return 100 end
    return (hum.Health / hum.MaxHealth) * 100
end

local function isAlive(char)
    local hum = getHum(char)
    return hum and hum.Health > 0
end

local function hasUltActive(char)
    if not char then return false end
    if char:GetAttribute("UltimateActive") then return true end
    for _, v in ipairs(char:GetChildren()) do
        local n = v.Name:lower()
        if n:find("ult") or n:find("aura") or n:find("awakened") then
            return true
        end
    end
    return false
end

local function fireinput(key)
    local vim = game:GetService("VirtualInputManager")
    vim:SendKeyEvent(true,  key, false, game)
    task.wait(0.05)
    vim:SendKeyEvent(false, key, false, game)
end

local function setNameplate(visible)
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, visible)
    end)
    local char = getChar()
    if char then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BillboardGui") then
                pcall(function() v.Enabled = visible end)
            end
        end
    end
end

local function teleportNear(targetHRP)
    local myHRP = getHRP(getChar())
    if not myHRP or not targetHRP then return end
    local angle  = math.random() * math.pi * 2
    local radius = math.random(3, 5)
    local offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
    myHRP.CFrame = CFrame.new(targetHRP.Position + offset)
        * CFrame.Angles(0, math.atan2(-offset.X, -offset.Z), 0)
end

local function doRetreat()
    local myHRP = getHRP(getChar())
    if not myHRP then return end
    retreating = true
    setNameplate(false)
    -- Chạy ngẫu nhiên + lên cao để thoát khỏi hitbox
    local dirs = {
        Vector3.new(1,0,0), Vector3.new(-1,0,0),
        Vector3.new(0,0,1), Vector3.new(0,0,-1),
        Vector3.new(1,0,1).Unit, Vector3.new(-1,0,-1).Unit,
    }
    local dir = dirs[math.random(1, #dirs)]
    myHRP.CFrame = CFrame.new(myHRP.Position + dir * CFG.RetreatRange + Vector3.new(0, 5, 0))
    task.wait(1.5)
    retreating = false
    setNameplate(true)
end

local function getTargets()
    local list = {}
    local myHRP = getHRP(getChar())
    if not myHRP then return list end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local tHRP = getHRP(plr.Character)
            if tHRP and isAlive(plr.Character) then
                local dist = (tHRP.Position - myHRP.Position).Magnitude
                local skipUlt = CFG.AvoidUltUsers and hasUltActive(plr.Character)
                if not skipUlt and dist <= CFG.FarmRange then
                    table.insert(list, {
                        plr  = plr,
                        hrp  = tHRP,
                        dist = dist,
                        hp   = getHPPct(plr.Character),
                    })
                end
            end
        end
    end

    -- Ưu tiên: target HP thấp lên đầu (dễ finish hơn)
    table.sort(list, function(a, b)
        -- target sắp chết → ưu tiên
        if (a.hp < CFG.FinisherHP) ~= (b.hp < CFG.FinisherHP) then
            return a.hp < CFG.FinisherHP
        end
        return a.dist < b.dist
    end)
    return list
end

-- =====================================================
-- ULT TRACKER
-- =====================================================
task.spawn(function()
    while true do
        task.wait(1)
        if (tick() - lastUlt) >= ULT_CD then
            ultReady = true
        end
    end
end)

-- =====================================================
-- COMBO ENGINE + FINISHER
-- =====================================================
local function doCombo(target)
    if comboCooldown then return end
    comboCooldown = true

    local targetHRP  = target.hrp
    local targetHP   = target.hp
    local isFinisher = targetHP < CFG.FinisherHP

    -- Ẩn nameplate trước khi đánh
    if CFG.HitAndFade then setNameplate(false) end

    -- Teleport gần target
    teleportNear(targetHRP)

    -- Face target
    local myHRP = getHRP(getChar())
    if myHRP then
        myHRP.CFrame = CFrame.lookAt(myHRP.Position, targetHRP.Position)
    end

    if isFinisher then
        -- ===== FINISHER PATH =====
        -- Target HP thấp → không waste full combo
        -- Dùng Skill 1 (Q) để finish — burst damage ngắn
        fireinput(CFG.FinisherSkill1)
        task.wait(0.15)

        -- Nếu ult ready → dùng luôn để chắc chắn kill
        if CFG.UseUlt and ultReady then
            fireinput(CFG.FinisherSkill2)
            lastUlt  = tick()
            ultReady = false
            task.wait(0.3)
        else
            -- Thêm Z spam nhẹ để seal
            for _ = 1, 2 do
                fireinput(CFG.ComboKey)
                task.wait(CFG.AttackDelay)
            end
        end
    else
        -- ===== FULL COMBO PATH =====
        -- Q — Incinerate
        fireinput(CFG.SkillKeys[1])
        task.wait(0.15)

        -- Z spam
        for _ = 1, CFG.ComboCount do
            fireinput(CFG.ComboKey)
            task.wait(CFG.AttackDelay)
        end

        -- E — Blaster
        fireinput(CFG.SkillKeys[2])
        task.wait(0.15)

        -- R — Arm Cannon
        fireinput(CFG.SkillKeys[3])
        task.wait(0.15)

        -- Ult nếu sẵn sàng (giữ cho finisher nhưng nếu dư thì xài)
        if CFG.UseUlt and ultReady then
            fireinput(CFG.UltKey)
            lastUlt  = tick()
            ultReady = false
            task.wait(0.3)
        end
    end

    -- Hit & fade: lùi ra sau combo
    if CFG.HitAndFade then
        local myHRP2 = getHRP(getChar())
        if myHRP2 then
            myHRP2.CFrame = CFrame.new(
                myHRP2.Position + myHRP2.CFrame.LookVector * -10
            )
        end
        task.wait(0.25)
        setNameplate(true)
    end

    task.wait(0.35)
    comboCooldown = false
end

-- =====================================================
-- MAIN LOOP
-- =====================================================
RunService.Heartbeat:Connect(function()
    if not farming then return end

    local char = getChar()
    if not char or not isAlive(char) then return end

    local hp = getHPPct(char)
    if hp < CFG.RetreatHP and not retreating then
        task.spawn(doRetreat)
        return
    end

    if retreating or comboCooldown then return end

    local now = tick()
    if (now - lastAttack) < CFG.AttackDelay then return end
    lastAttack = now

    local targets = getTargets()
    if #targets == 0 then return end

    task.spawn(function()
        doCombo(targets[1])
    end)
end)

