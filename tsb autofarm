local function addLog(msg)
    local t = os.date("%H:%M:%S")
    table.insert(logLines, 1, t .. "  " .. msg)
    while #logLines > MAX_LOG_LINES do
        table.remove(logLines)
    end
end

local function formatTime(sec)
    sec = math.max(0, math.floor(sec))
    local m = math.floor(sec / 60)
    local s = sec % 60
    return string.format("%02d:%02d", m, s)
end

-- ===== WEBHOOK =====
local function sendWebhook(title, desc, color)
    if webhookUrl == "" then return false end
    local ok = pcall(function()
        local body = HttpService:JSONEncode({
            username = "CatLazy",
            embeds = {{
                title = title,
                description = desc,
                color = color or 0x78c8ff,
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
                footer = { text = "CatLazy Auto Candy" },
            }},
        })
        local fn = request or (syn and syn.request) or (http and http.request) or http_request
        if fn then
            fn({
                Url = webhookUrl,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body,
            })
        end
    end)
    return ok
end

