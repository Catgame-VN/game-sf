--[[
    TSB Genos Auto Farm v5.2
    - Tự động tìm target gần nhất, không cần nhập tên
    - Tàng hình: ẩn character khỏi người khác
    - Hit & fade: teleport random sau mỗi combo
    - Lag reduce nuclear
]]

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LP = Players.LocalPlayer

local CFG = {
    FarmEnabled   = true,
    AttackRange   = 10,
    ComboDelay    = 0.1,
    M1Interval    = 0.13,
    RetreatHP     = 45,
    RetreatDist   = 80,
    FinisherHP    = 30,
    UltCD         = 60,
    SkillCD       = 8,
    NoFlyAnchor   = true,
    LagReduce     = true,
    AutoRespawn   = true,
    Invisible     = true,   -- tàng hình
    FadeRange     = 15,     -- sau combo teleport random trong range này
}

local farming       = CFG.FarmEnabled
local retreating    = false
local comboCooldown = false
local lastUlt       = 0
local lastSkill     = 0
local anchoredTargets = {}

-- ============================================================
-- NUCLEAR LAG REDUCE
-- ============================================================
if CFG.LagReduce then
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    local lighting = game:GetService("Lighting")
    lighting.GlobalShadows = false
    lighting.FogEnd = 999999
    pcall(function()
        for _, v in ipairs(lighting:GetChildren()) do
            if v:IsA("BlurEffect") or v:IsA("SunRaysEffect")
            or v:IsA("ColorCorrectionEffect") or v:IsA("DepthOfFieldEffect") then
                v.Enabled = false
            end
        end
    end)
    local function nukeVFX(v)
        pcall(function()
            if LP.Character and v:IsDescendantOf(LP.Character) then return end
            if v:IsA("ParticleEmitter") then v.Rate=0; v.Enabled=false
            elseif v:IsA("Beam") or v:IsA("Trail") or v:IsA("Fire")
                or v:IsA("Smoke") or v:IsA("Sparkles") then v.Enabled=false
            elseif v:IsA("Decal") or v:IsA("Texture") then v.Transparency=1
            elseif v:IsA("PointLight") or v:IsA("SpotLight")
                or v:IsA("SurfaceLight") then v.Enabled=false
            elseif v:IsA("BasePart") then v.CastShadow=false end
        end)
    end
    for _, v in ipairs(workspace:GetDescendants()) do nukeVFX(v) end
    workspace.DescendantAdded:Connect(nukeVFX)
end

-- ============================================================
-- TÀNG HÌNH — ẩn local character với người khác
-- client-side: parts transparent + tắt nameplate + tắt shadow
-- ============================================================
local function applyInvisible(char)
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        pcall(function()
            if v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("SpecialMesh") then
                v.Transparency = 1
                v.CastShadow = false
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = 1
            elseif v:IsA("BillboardGui") or v:IsA("ScreenGui") then
                v.Enabled = false
            end
        end)
    end
    -- giữ HumanoidRootPart visible=false nhưng không transparent
    -- để hitbox vẫn hoạt động
    pcall(function()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Transparency = 1 end
    end)
end

local function reapplyInvisible()
    if not CFG.Invisible then return end
    local char = LP.Character
    if char then applyInvisible(char) end
end

-- reapply mỗi khi character spawn
LP.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if CFG.Invisible then applyInvisible(char) end
end)

-- reapply liên tục phòng game reset transparency
RunService.Heartbeat:Connect(function()
    if not CFG.Invisible then return end
    local char = LP.Character
    if not char then return end
    -- chỉ check Head để không lag
    pcall(function()
        local head = char:FindFirstChild("Head")
        if head and head.Transparency ~= 1 then
            applyInvisible(char)
        end
    end)
end)

-- apply ngay lần đầu
task.spawn(function()
    task.wait(1)
    if CFG.Invisible then reapplyInvisible() end
end)

-- ============================================================
-- GET TARGET REMOTE — tự tìm theo tên player, không cần nhập
-- ============================================================
local globalRemote
pcall(function()
    globalRemote = RS.Resources.Brother["#Friend"].Communicate
end)

local function getTargetRemote(targetName)
    local ok, remote = pcall(function()
        return workspace.Live[targetName].Communicate
    end)
    if ok and remote then return remote end
    return globalRemote
end

-- ============================================================
-- HELPERS
-- ============================================================
local function getChar() return LP.Character end
local function getHRP(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function getHum(char)
    return char and char:FindFirstChildWhichIsA("Humanoid")
end
local function isAlive(char)
    local hum = getHum(char)
    return hum and hum.Health > 0
end
local function getHPPct(char)
    local hum = getHum(char)
    if not hum then return 0 end
    return (hum.Health / hum.MaxHealth) * 100
end

-- ============================================================
-- AUTO TARGET SELECTION — tự tìm, không cần nhập tên
-- ============================================================
local function getTargets()
    local myChar = getChar()
    local myHRP = getHRP(myChar)
    if not myHRP then return {} end
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        if not char or not isAlive(char) then continue end
        local hrp = getHRP(char)
        if not hrp then continue end
        local dist = (hrp.Position - myHRP.Position).Magnitude
        local hp = getHPPct(char)
        table.insert(list, {
            char = char,
            hrp  = hrp,
            dist = dist,
            hp   = hp,
            name = plr.Name,
            plr  = plr,
        })
    end
    -- ưu tiên: HP thấp < 30% lên đầu, còn lại sort theo khoảng cách
    table.sort(list, function(a, b)
        if a.hp < CFG.FinisherHP and b.hp >= CFG.FinisherHP then return true end
        if b.hp < CFG.FinisherHP and a.hp >= CFG.FinisherHP then return false end
        return a.dist < b.dist
    end)
    return list
end

-- ============================================================
-- TELEPORT + RETREAT + HIT-FADE
-- ============================================================
local function tpBehindTarget(targetHRP)
    local myHRP = getHRP(getChar())
    if not myHRP or not targetHRP then return end
    -- teleport ngay sau lưng target
    local dir = (myHRP.Position - targetHRP.Position).Unit
    myHRP.CFrame = CFrame.new(targetHRP.Position + dir * 3 + Vector3.new(0, 1, 0))
end

local function fadeAway(fromPos)
    -- teleport random trong CFG.FadeRange sau khi đánh
    local myHRP = getHRP(getChar())
    if not myHRP then return end
    local angle = math.random() * math.pi * 2
    local r = CFG.FadeRange * (0.5 + math.random() * 0.5)
    myHRP.CFrame = CFrame.new(
        fromPos + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
    )
end

local function retreat()
    retreating = true
    local myHRP = getHRP(getChar())
    if myHRP then
        local angle = math.random() * math.pi * 2
        myHRP.CFrame = CFrame.new(myHRP.Position
            + Vector3.new(math.cos(angle), 0, math.sin(angle)) * CFG.RetreatDist)
    end
    task.wait(3)
    retreating = false
end

-- ============================================================
-- NO-FLY ANCHOR
-- ============================================================
local function startAnchor(targetChar)
    if not CFG.NoFlyAnchor or anchoredTargets[targetChar] then return end
    local tHRP = getHRP(targetChar)
    if not tHRP then return end
    local groundY = tHRP.Position.Y
    anchoredTargets[targetChar] = true
    task.spawn(function()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not anchoredTargets[targetChar] or not isAlive(targetChar) or not tHRP.Parent then
                conn:Disconnect(); anchoredTargets[targetChar] = nil; return
            end
            pcall(function()
                local vel = tHRP.AssemblyLinearVelocity
                if vel.Y > 5 then
                    tHRP.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                end
                if tHRP.Position.Y > groundY + 8 then
                    tHRP.CFrame = CFrame.new(tHRP.Position.X, groundY + 1, tHRP.Position.Z)
                end
            end)
        end)
        task.wait(4)
        conn:Disconnect()
        anchoredTargets[targetChar] = nil
    end)
end

-- ============================================================
-- FIRE COMBAT
-- ============================================================
local ACTION_M1    = {"M1", "Punch", 1, "BasicAttack", "Attack"}
local ACTION_SKILL = {"Q", "Skill1", 2, "E", "Skill"}
local ACTION_ULT   = {"R", "Ult", 3, "Ultimate", "F"}

local function fireCombat(remote, targetChar, actionList)
    if not remote then return end
    local tHRP = getHRP(targetChar)
    for _, action in ipairs(actionList) do
        pcall(function() remote:FireServer(action) end)
        pcall(function() remote:FireServer(action, targetChar) end)
        if tHRP then
            pcall(function() remote:FireServer(action, tHRP) end)
            pcall(function() remote:FireServer(action, tHRP.Position) end)
        end
    end
    if globalRemote and globalRemote ~= remote then
        for _, action in ipairs(actionList) do
            pcall(function() globalRemote:FireServer(action) end)
            if tHRP then
                pcall(function() globalRemote:FireServer(action, tHRP.Position) end)
            end
        end
    end
    local myHum = getHum(getChar())
    if myHum and tHRP then
        pcall(function() myHum:MoveTo(tHRP.Position) end)
    end
end

-- ============================================================
-- COMBO ENGINE
-- ============================================================
local function doCombo(target)
    if comboCooldown then return end
    comboCooldown = true

    local remote = getTargetRemote(target.name)
    local attackPos = target.hrp and target.hrp.Position or Vector3.new(0,0,0)

    tpBehindTarget(target.hrp)
    startAnchor(target.char)

    local now = tick()

    if target.hp < CFG.FinisherHP then
        for _ = 1, 3 do
            if not isAlive(target.char) then break end
            fireCombat(remote, target.char, ACTION_M1)
            task.wait(CFG.ComboDelay)
        end
        if now - lastSkill > CFG.SkillCD then
            fireCombat(remote, target.char, ACTION_SKILL)
            lastSkill = now
            task.wait(0.3)
        end
        if now - lastUlt > CFG.UltCD then
            fireCombat(remote, target.char, ACTION_ULT)
            lastUlt = now
        end
    else
        for i = 1, 5 do
            if not isAlive(target.char) then break end
            fireCombat(remote, target.char, ACTION_M1)
            task.wait(CFG.ComboDelay)
        end
        if now - lastSkill > CFG.SkillCD then
            fireCombat(remote, target.char, ACTION_SKILL)
            lastSkill = now
        end
    end

    -- fade sau combo
    fadeAway(attackPos)

    task.wait(0.4)
    comboCooldown = false
end

-- ============================================================
-- ULT AUTO LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(1)
        if not farming then continue end
        local now = tick()
        if now - lastUlt < CFG.UltCD then continue end
        if not isAlive(getChar()) then continue end
        local targets = getTargets()
        if #targets > 0 and targets[1].dist < 20 then
            local r = getTargetRemote(targets[1].name)
            fireCombat(r, targets[1].char, ACTION_ULT)
            lastUlt = now
        end
    end
end)

-- ============================================================
-- CONTINUOUS M1 LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(CFG.M1Interval)
        if not farming or retreating or comboCooldown then continue end
        if not isAlive(getChar()) then continue end
        local targets = getTargets()
        if #targets > 0 and targets[1].dist < 8 then
            local r = getTargetRemote(targets[1].name)
            fireCombat(r, targets[1].char, ACTION_M1)
            startAnchor(targets[1].char)
        end
    end
end)

-- ============================================================
-- MAIN LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(0.2)
        if not farming then continue end
        local myChar = getChar()
        if not myChar or not isAlive(myChar) then
            if CFG.AutoRespawn then
                pcall(function() LP:LoadCharacter() end)
                task.wait(3)
            end
            continue
        end
        if getHPPct(myChar) < CFG.RetreatHP and not retreating then
            task.spawn(retreat); continue
        end
        if retreating then continue end
        local targets = getTargets()
        if #targets == 0 then continue end
        local best = targets[1]
        if best.dist > CFG.AttackRange then
            tpBehindTarget(best.hrp)
            task.wait(0.1)
        else
            task.spawn(function() doCombo(best) end)
            task.wait(CFG.ComboDelay * 5)
        end
    end
end)

