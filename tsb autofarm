-- ===== HOP =====
local function hopServer(reason)
    setStatus("Hopping server...")
    addLog("Hop: " .. (reason or "manual"))

    if queue_on_teleport then
        queue_on_teleport([[
            loadstring(game:HttpGet("]] .. SCRIPT_URL .. [["))()
        ]])
    end

    local ok, servers = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet(
                "https://games.roblox.com/v1/games/"
                .. game.PlaceId
                .. "/servers/Public?sortOrder=Asc&limit=100"
            )
        )
    end)

    if ok and servers and servers.data then
        local total = 0
        for _ in ipairs(servers.data) do total = total + 1 end
        addLog("Found " .. total .. " servers")

        for _, s in ipairs(servers.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                addLog(s.playing .. "/" .. s.maxPlayers .. " -> teleport")
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, player)
                end)
                return
            end
        end
        addLog("All full - rejoin")
    else
        addLog("Fetch failed - rejoin")
    end

    pcall(function()
        TeleportService:Teleport(game.PlaceId, player)
    end)
end

local function isBusy(character)
    return character:FindFirstChild("RootAnchor") or
        character:FindFirstChild("NoRotate")
end

local function findClosestDoor(root)
    local closestPrompt
    local closestPart
    local closestDistance = math.huge

    for _, tree in ipairs(trees:GetChildren()) do
        local door = tree:FindFirstChild("DOOR 1 NEW")
        local frame = door and door:FindFirstChild("Frame")
        local prompt = frame and frame:FindFirstChild("TrickOrTreat")

        if prompt and prompt:IsA("ProximityPrompt")
            and prompt ~= lastDoorPrompt
            and not badPrompts[prompt] then
            local part = prompt.Parent

            if part and part:IsA("BasePart") then
                local distance = (root.Position - part.Position).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closestPrompt = prompt
                    closestPart = part
                end
            end
        end
    end

    return closestPrompt, closestPart
end

-- ===== KNOCK DOOR =====
local function knockDoor(prompt, part, character, root, humanoid)
    -- teleport tới door
    pcall(function()
        root.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
    end)
    root.AssemblyLinearVelocity = Vector3.zero

    -- đợi server register vị trí
    task.wait(DOOR_POST_TP_WAIT)

    local fired = false
    for attempt = 1, DOOR_FIRE_RETRIES do
        if humanoid.Health <= 0 then return false end
        if not prompt.Parent then fired = true; break end
        if isBusy(character) then fired = true; break end

        pcall(function()
            fireproximityprompt(prompt)
        end)

        -- verify: busy bật / prompt disable / prompt bị destroy
        local waited = 0
        while waited < DOOR_BUSY_WAIT do
            task.wait(DOOR_FIRE_GAP)
            waited = waited + DOOR_FIRE_GAP
            if isBusy(character) then fired = true; break end
            if not prompt.Parent then fired = true; break end
        end
        if fired then break end
    end

    return fired
end

addLog("Loaded - hop every 15m")

while task.wait() do
    -- check hop interval
    if tick() - hopStart >= HOP_INTERVAL then
        hopServer("15m timer")
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid then
        setStatus("Waiting for character...")
        busySince = nil
        continue
    end

    if humanoid.Health <= 0 then
        setStatus("Character dead...")
        busySince = nil
        continue
    end

    -- check busy + timeout
    if isBusy(character) then
        if not busySince then busySince = tick() end
        local busyDur = tick() - busySince
        if busyDur > BUSY_TIMEOUT then
            setStatus("Door stuck - escaping...")
            addLog("Busy " .. math.floor(busyDur) .. "s - teleport away")
            -- nhảy ra xa để phá animation kẹt
            pcall(function()
                root.CFrame = root.CFrame + Vector3.new(0, 30, 0)
            end)
            task.wait(0.3)
            busySince = nil
            badPrompts[lastDoorPrompt] = true
            lastDoorPrompt = nil
        else
            setStatus("Door... (" .. math.floor(busyDur) .. "s)")
        end
        continue
    else
        busySince = nil
    end

    -- check cooldown sau knock
    if os.clock() < doorCooldownUntil then
        local remaining = math.ceil(doorCooldownUntil - os.clock())
        setStatus("Cooldown " .. remaining .. "s")
        continue
    end

    -- tìm candy
    local closestCandy
    local closestDistance = math.huge

    for _, candy in ipairs(folder:GetChildren()) do
        local rest = candy:GetAttribute("Rest")

        if rest then
            local distance = (root.Position - rest.Position).Magnitude

            if distance < closestDistance then
                closestDistance = distance
                closestCandy = rest
            end
        end
    end

    if closestCandy then
        setStatus("Collecting candy...")
        root.CFrame = CFrame.new(closestCandy.Position + Vector3.new(0, 4, 0))
        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        continue
    end

    -- tìm door
    local prompt, part = findClosestDoor(root)

    -- nếu không còn door nào (do ignore + bad), reset ignore
    if not prompt then
        lastDoorPrompt = nil
        prompt, part = findClosestDoor(root)
    end

    if prompt and part then
        setStatus("Visiting door...")
        local ok = knockDoor(prompt, part, character, root, humanoid)

        if ok then
            lastDoorPrompt = prompt
            doorCooldownUntil = os.clock() + DOOR_WAIT_TIME
            setStatus("Door knocked - waiting " .. DOOR_WAIT_TIME .. "s")
        else
            badPrompts[prompt] = true
            addLog("Fire failed - skip door")
            task.wait(0.3)
        end
    else
        setStatus("No candy - no doors")
        root.CFrame = CFrame.new(0, 100, 0)
    end
end
