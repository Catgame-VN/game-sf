-- TSB Auto Farm + Tàng hình (Invisible)

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VIM = game:GetService("VirtualInputManager")
local LP = Players.LocalPlayer
local PG = LP:WaitForChild("PlayerGui")

local CONFIG = {
    auto_farm = false,
    kill_aura = true,
    invisible = true,     -- Bật tàng hình
    hitbox_size = 25,     -- Kích thước hitbox của địch (25 là an toàn)
    attack_range = 25,    -- Khoảng cách tối đa để đánh
    m1_speed = 0.05,      -- Tốc độ đấm
    use_skills = true,    -- Tự spam skill (Z, X, C, V, F, G)
    skill_delay = 1.5,
    auto_dodge = true,
}

local function log(m) print("[TSB] " .. m) end

local function getChar()
    return LP.Character or LP.CharacterAdded:Wait()
end

-- ===== HÀM TÀNG HÌNH (INVISIBILITY) =====
local function setInvisibility(state)
    local char = LP.Character
    if not char then return end
    
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Transparency = state and 1 or 0
            v.CanCollide = not state -- Nếu tàng hình thì tắt va chạm để đi xuyên
        elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("Accessory") then
            v.Transparency = state and 1 or 0
        elseif v:IsA("BillboardGui") then
            v.Enabled = not state -- Xoá tên trên đầu
        end
    end
    
    -- Xử lý riêng cho cái bóng (Shadow)
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local shadow = humanoid:FindFirstChild("Shadow")
        if shadow and shadow:IsA("BasePart") then
            shadow.Transparency = state and 1 or 0
        end
    end
end

-- Duy trì tàng hình khi respawn
LP.CharacterAdded:Connect(function(char)
    task.wait(1)
    if CONFIG.invisible then
        setInvisibility(true)
    end
end)

-- ===== TÌM ĐỊCH GẦN NHẤT =====
local function getNearestEnemy()
    local myChar = getChar()
    if not myChar then return nil end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHRP or not myHum or myHum.Health <= 0 then return nil end

    local closest = nil
    local minDist = CONFIG.attack_range

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local char = plr.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                local dist = (myHRP.Position - hrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = hrp
                end
            end
        end
    end
    return closest
end

-- ===== AUTOFARM LOGIC =====
task.spawn(function()
    while true do
        if CONFIG.auto_farm then
            local myChar = getChar()
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local enemyHRP = getNearestEnemy()

            if myHRP and enemyHRP then
                -- Tự xoay mặt về phía địch
                myHRP.CFrame = CFrame.lookAt(myHRP.Position, enemyHRP.Position)

                -- Đấm (M1)
                if CONFIG.kill_aura then
                    VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(CONFIG.m1_speed)
                    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end

                -- Spam Skill
                if CONFIG.use_skills then
                    local skills = {0x5A, 0x58, 0x43, 0x56, 0x46, 0x47} -- Z X C V F G
                    for _, key in ipairs(skills) do
                        VIM:SendKeyEvent(true, key, false, game)
                        task.wait(0.05)
                        VIM:SendKeyEvent(false, key, false, game)
                    end
                    task.wait(CONFIG.skill_delay)
                end
            end
        end
        task.wait(0.01)
    end
end)

-- ===== HITBOX EXTENDER (Phóng to hitbox địch) =====
task.spawn(function()
    RunService.Stepped:Connect(function()
        if not CONFIG.auto_farm then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                for _, part in ipairs(plr.Character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Size = Vector3.new(CONFIG.hitbox_size, CONFIG.hitbox_size, CONFIG.hitbox_size)
                        part.Transparency = 0.7 -- Nhìn thấy mờ mờ để biết vị trí địch
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end)

-- ===== AUTO DODGE =====
task.spawn(function()
    while true do
        if CONFIG.auto_farm and CONFIG.auto_dodge then
            local myChar = getChar()
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if myHum and myHum.Health < myHum.MaxHealth * 0.8 then
                VIM:SendKeyEvent(true, 0x20, false, game)
                task.wait(0.1)
                VIM:SendKeyEvent(false, 0x20, false, game)
                task.wait(1.5)
            end
        end
        task.wait(0.5)
    end
end)

