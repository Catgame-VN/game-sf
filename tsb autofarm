-- =====================================================
-- HELPERS
-- =====================================================
local function getChar() return LP.Character end
local function getHRP(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(c) return c and c:FindFirstChildWhichIsA("Humanoid") end

local function getHPPct(char)
    local hum = getHum(char)
    if not hum or hum.MaxHealth == 0 then return 100 end
    return (hum.Health / hum.MaxHealth) * 100
end

local function isAlive(char)
    local hum = getHum(char)
    return hum and hum.Health > 0
end

local function hasUltActive(char)
    if not char then return false end
    if char:GetAttribute("UltimateActive") then return true end
    for _, v in ipairs(char:GetChildren()) do
        local n = v.Name:lower()
        if n:find("ult") or n:find("aura") or n:find("awakened") then return true end
    end
    return false
end

local function setNameplate(visible)
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, visible) end)
    local char = getChar()
    if char then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BillboardGui") then
                pcall(function() v.Enabled = visible end)
            end
        end
    end
end

local function teleportToTarget(targetHRP)
    local myHRP = getHRP(getChar())
    if not myHRP or not targetHRP then return end
    local angle  = math.random() * math.pi * 2
    local radius = math.random(2, 4)
    local offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
    myHRP.CFrame = CFrame.new(targetHRP.Position + offset, targetHRP.Position)
end

local function doRetreat()
    local myHRP = getHRP(getChar())
    if not myHRP then return end
    retreating = true
    setNameplate(false)
    local dirs = {
        Vector3.new(1,0,0), Vector3.new(-1,0,0),
        Vector3.new(0,0,1), Vector3.new(0,0,-1),
        Vector3.new(1,0,1).Unit, Vector3.new(-1,0,-1).Unit,
    }
    local dir = dirs[math.random(1, #dirs)]
    myHRP.CFrame = CFrame.new(
        myHRP.Position + dir * CFG.RetreatRange + Vector3.new(0, 5, 0)
    )
    task.wait(1.5)
    retreating = false
    setNameplate(true)
end

local function getTargets()
    local list = {}
    local myHRP = getHRP(getChar())
    if not myHRP then return list end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local tHRP = getHRP(plr.Character)
            if tHRP and isAlive(plr.Character) then
                local dist = (tHRP.Position - myHRP.Position).Magnitude
                local skipUlt = CFG.AvoidUltUsers and hasUltActive(plr.Character)
                if not skipUlt and dist <= CFG.FarmRange then
                    table.insert(list, {
                        plr  = plr,
                        hrp  = tHRP,
                        dist = dist,
                        hp   = getHPPct(plr.Character),
                        char = plr.Character,
                    })
                end
            end
        end
    end
    table.sort(list, function(a, b)
        if (a.hp < CFG.FinisherHP) ~= (b.hp < CFG.FinisherHP) then
            return a.hp < CFG.FinisherHP
        end
        return a.dist < b.dist
    end)
    return list
end

-- =====================================================
-- NO-FLY ANCHOR
-- Giữ target dính đất — không bị văng lên trời khi bị đánh
-- Cách: liên tục set Velocity = 0 + Y position lock
-- =====================================================
local function startAnchor(targetChar)
    if not CFG.NoFlyAnchor then return end
    if anchoredTargets[targetChar] then return end  -- đã anchor rồi

    local tHRP = getHRP(targetChar)
    if not tHRP then return end

    local groundY = tHRP.Position.Y  -- Y ban đầu khi bắt đầu anchor
    anchoredTargets[targetChar] = true

    task.spawn(function()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            -- Dừng anchor nếu target chết hoặc out of range
            if not anchoredTargets[targetChar]
            or not isAlive(targetChar)
            or not tHRP.Parent then
                conn:Disconnect()
                anchoredTargets[targetChar] = nil
                return
            end

            pcall(function()
                -- Tắt gravity tạm thời bằng cách set AssemblyLinearVelocity Y = 0
                -- nếu đang bị bay lên (Y velocity > 5)
                local vel = tHRP.AssemblyLinearVelocity
                if vel.Y > 5 then
                    tHRP.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                end

                -- Nếu target bị ném quá cao so với ground → kéo về
                if tHRP.Position.Y > groundY + 8 then
                    tHRP.CFrame = CFrame.new(
                        tHRP.Position.X,
                        groundY + 1,
                        tHRP.Position.Z
                    )
                end
            end)
        end)

        -- Tự release sau 4 giây (1 combo cycle)
        task.wait(4)
        conn:Disconnect()
        anchoredTargets[targetChar] = nil
    end)
end

local function stopAnchor(targetChar)
    anchoredTargets[targetChar] = nil
end

-- =====================================================
-- M1 SPAM ENGINE
-- Dùng: hookmetamethod hoặc FireServer trực tiếp
-- TSB M1 thường là ClickDetector hoặc RemoteEvent "Attack"/"M1"/"Combat"
-- =====================================================
local lastM1 = 0

local function fireM1(targetChar)
    if not CFG.AutoM1 then return end
    local now = tick()
    if (now - lastM1) < CFG.M1Interval then return end
    lastM1 = now

    local tHRP = getHRP(targetChar)
    if not tHRP then return end

    -- Method 1: FireServer các remote M1 phổ biến
    local m1Names = {
        "Attack", "M1", "Combat", "Punch",
        "BasicAttack", "Hit", "DealDamage",
        "CombatRemote", "AttackRemote",
    }
    for _, name in ipairs(m1Names) do
        local r = getRemote(name)
        if r then
            pcall(function() r:FireServer(targetChar) end)
            pcall(function() r:FireServer(tHRP) end)
            pcall(function() r:FireServer(tHRP.Position) end)
        end
    end

    -- Method 2: Simulate click trên target HRP (một số game dùng ClickDetector)
    pcall(function()
        local cd = tHRP:FindFirstChildWhichIsA("ClickDetector")
            or targetChar:FindFirstChildWhichIsA("ClickDetector")
        if cd then
            fireclickdetector(cd)
        end
    end)

    -- Method 3: Humanoid MoveTo để trigger hitbox range check server-side
    local myHum = getHum(getChar())
    if myHum then
        pcall(function() myHum:MoveTo(tHRP.Position) end)
    end
end

-- =====================================================
-- SKILL FIRE
-- =====================================================
local function trySkill(skillIndex, targetChar)
    local skillRemotes = {
        {"Skill", "UseSkill", "ActivateSkill", "Ability", "Skill1", "Q"},
        {"Skill2", "UseSkill2", "E"},
        {"Skill3", "UseSkill3", "R"},
        {"Ultimate", "Ult", "UseUltimate", "ActivateUlt", "F", "UltRemote"},
    }
    local names = skillRemotes[math.clamp(skillIndex, 1, 4)]
    for _, rname in ipairs(names) do
        local r = getRemote(rname)
        if r then
            pcall(function() r:FireServer() end)
            pcall(function() r:FireServer(targetChar) end)
            if targetChar then
                local tHRP = getHRP(targetChar)
                if tHRP then
                    pcall(function() r:FireServer(tHRP.Position) end)
                end
            end
        end
    end
end

