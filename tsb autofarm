local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer
local folder = workspace:WaitForChild("HalloweenCandy")
local trees = workspace:WaitForChild("HalloweenDoorTrees")
local camera = workspace.CurrentCamera

local HOP_INTERVAL = 15 * 60
local SCRIPT_URL = "https://raw.githubusercontent.com/Catgame-VN/game-sf/refs/heads/main/tsb%20autof"

local status = Drawing.new("Text")
status.Text = "Finding candy..."
status.Size = 18
status.Center = true
status.Outline = true
status.Color = Color3.fromRGB(255, 255, 255)
status.Position = Vector2.new(camera.ViewportSize.X / 2, 35)
status.Visible = true

game:GetService("RunService").RenderStepped:Connect(function()
    camera = workspace.CurrentCamera
    status.Position = Vector2.new(camera.ViewportSize.X / 2, 35)
end)

local function setStatus(message)
    status.Text = "Discord: discord.gg/aBq4NTkMyP\nStatus: " .. message
end

-- HOP SERVER + re-exec sau khi hop
local function hopServer()
    setStatus("Hopping server...")

    if queue_on_teleport then
        queue_on_teleport([[
            loadstring(game:HttpGet("]] .. SCRIPT_URL .. [["))()
        ]])
    end

    local ok, servers = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet(
                "https://games.roblox.com/v1/games/"
                .. game.PlaceId
                .. "/servers/Public?sortOrder=Asc&limit=100"
            )
        )
    end)

    if ok and servers and servers.data then
        for _, s in ipairs(servers.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, player)
                end)
                return
            end
        end
    end

    pcall(function()
        TeleportService:Teleport(game.PlaceId, player)
    end)
end

local hopStart = tick()

local function isBusy(character)
    return character:FindFirstChild("RootAnchor") or
        character:FindFirstChild("NoRotate")
end

local function findClosestDoor(root)
    local closestPrompt
    local closestPart
    local closestDistance = math.huge

    for _, tree in ipairs(trees:GetChildren()) do
        local door = tree:FindFirstChild("DOOR 1 NEW")
        local frame = door and door:FindFirstChild("Frame")
        local prompt = frame and frame:FindFirstChild("TrickOrTreat")

        if prompt and prompt:IsA("ProximityPrompt") then
            local part = prompt.Parent

            if part and part:IsA("BasePart") then
                local distance = (root.Position - part.Position).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closestPrompt = prompt
                    closestPart = part
                end
            end
        end
    end

    return closestPrompt, closestPart
end

while task.wait() do
    if tick() - hopStart >= HOP_INTERVAL then
        hopServer()
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid then
        setStatus("Waiting for character...")
        continue
    end

    if humanoid.Health <= 0 then
        setStatus("Character dead...")
        continue
    end

    if isBusy(character) then
        setStatus("Door...")
        continue
    end

    local closestCandy
    local closestDistance = math.huge

    for _, candy in ipairs(folder:GetChildren()) do
        local rest = candy:GetAttribute("Rest")

        if rest then
            local distance = (root.Position - rest.Position).Magnitude

            if distance < closestDistance then
                closestDistance = distance
                closestCandy = rest
            end
        end
    end

    if closestCandy then
        setStatus("Collecting candy...")
        root.CFrame = CFrame.new(closestCandy.Position + Vector3.new(0, 4, 0))
        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    else
        local prompt, part = findClosestDoor(root)

        if prompt and part then
            setStatus("Visiting closest door...")
            humanoid.Jump = true
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            root.CFrame = part.CFrame
            fireproximityprompt(prompt)
        else
            setStatus("No candy - No doors found")
            root.CFrame = CFrame.new(0, 100, 0)
        end
    end
end
