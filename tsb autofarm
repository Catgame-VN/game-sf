--[[
v2.4: anti-lag + auto hop 15m + auto re-exec
fix: đứng DƯỚI gốc cây, offset âm Y sâu
     + stuck detector + CanCollide bypass
]]
if queue_on_teleport then
    queue_on_teleport([[
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Catgame-VN/game-sf/refs/heads/main/tsb%20autofarm"))()
    ]])
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local folder = workspace:WaitForChild("HalloweenCandy")
local trees = workspace:WaitForChild("HalloweenDoorTrees")
local camera = workspace.CurrentCamera

local HOP_INTERVAL = 15 * 60
local CANDY_REFRESH = 0.15
local DOOR_REFRESH = 0.5

-- đứng DƯỚI gốc cây: âm Y sâu
local UNDER_OFFSET = Vector3.new(0, -6, 0)
-- nếu door part nằm sát ground, ép xuống thêm
local UNDER_MIN_Y = -4
-- stuck check
local STUCK_TIME = 3
local STUCK_MOVE_MIN = 1.5

local status = Drawing.new("Text")
status.Text = "Status: Booting..."
status.Size = 18
status.Center = true
status.Outline = true
status.Color = Color3.fromRGB(255, 255, 255)
status.Position = Vector2.new(camera.ViewportSize.X / 2, 35)
status.Visible = true

local function setStatus(msg) status.Text = "Status: " .. msg end
local function cleanup() if status then status:Remove() end end

local function hopServer()
    setStatus("Hopping server...")
    cleanup()
    local ok, servers = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet("https://games.roblox.com/v1/games/" ..
            game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        )
    end)
    if ok and servers and servers.data then
        for _, s in ipairs(servers.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, player)
                end)
                return
            end
        end
    end
    pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
end

local hopStart = tick()
local lastCandyScan = 0
local lastDoorScan = 0
local cachedCandy, cachedDoor, cachedDoorPart = nil, nil, nil
local promptCooldown = 0
local lastPos = Vector3.zero
local lastMoveCheck = 0
local stuckCount = 0

local function isBusy(char)
    return char:FindFirstChild("RootAnchor") or char:FindFirstChild("NoRotate")
end

local function safeTeleport(root, pos, hum)
    local prevCollide = root.CanCollide
    pcall(function() root.CanCollide = false end)
    local ok = pcall(function()
        root.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(root.Orientation.Y), 0)
    end)
    if not ok then
        pcall(function() root.CFrame = CFrame.new(pos) end)
    end
    if hum then
        hum.Jump = true
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    end
    task.wait(0.15)
    pcall(function() root.CanCollide = prevCollide end)
end

-- tìm vị trí DƯỚI gốc cây: lấy X,Z của door part, ép Y xuống
local function underTreePos(doorPart)
    local p = doorPart.Position + UNDER_OFFSET
    -- nếu door part cao, ép Y âm thêm để chui sâu
    if doorPart.Position.Y > 5 then
        p = Vector3.new(doorPart.Position.X, doorPart.Position.Y - 8, doorPart.Position.Z)
    end
    -- safety: không xuống quá sâu dưới ground
    if p.Y < UNDER_MIN_Y then
        p = Vector3.new(p.X, UNDER_MIN_Y, p.Z)
    end
    return p
end

local function scanCandy(root)
    local best, bestDist = nil, math.huge
    local children = folder:GetChildren()
    for i = 1, #children do
        local rest = children[i]:GetAttribute("Rest")
        if rest then
            local d = (root.Position - rest.Position).Magnitude
            if d < bestDist then bestDist, best = d, rest end
        end
    end
    return best
end

local function scanDoor(root)
    local bestPrompt, bestPart, bestDist = nil, nil, math.huge
    local kids = trees:GetChildren()
    for i = 1, #kids do
        local tree = kids[i]
        local door = tree:FindFirstChild("DOOR 1 NEW")
        local frame = door and door:FindFirstChild("Frame")
        local prompt = frame and frame:FindFirstChild("TrickOrTreat")
        if prompt and prompt:IsA("ProximityPrompt") then
            local part = prompt.Parent
            if part and part:IsA("BasePart") then
                local d = (root.Position - part.Position).Magnitude
                if d < bestDist then
                    bestDist, bestPrompt, bestPart = d, prompt, part
                end
            end
        end
    end
    return bestPrompt, bestPart
end

RunService.RenderStepped:Connect(function()
    local c = workspace.CurrentCamera
    if c then status.Position = Vector2.new(c.ViewportSize.X / 2, 35) end
end)

local alive = true
task.spawn(function()
    while alive do
        local now = tick()
        if now - hopStart >= HOP_INTERVAL then
            hopServer(); return
        end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if not root or not hum then
            setStatus("Waiting for character...")
        elseif hum.Health <= 0 then
            setStatus("Character dead...")
        elseif isBusy(char) then
            setStatus("Door...")
        else
            if now - lastMoveCheck > 1 then
                local moved = (root.Position - lastPos).Magnitude
                if moved < STUCK_MOVE_MIN then stuckCount = stuckCount + 1
                else stuckCount = 0 end
                lastPos = root.Position
                lastMoveCheck = now
                if stuckCount >= STUCK_TIME then
                    setStatus("Stuck - escaping...")
                    safeTeleport(root, root.Position + Vector3.new(0, 25, 0), hum)
                    task.wait(0.3)
                    stuckCount = 0
                end
            end

            if now - lastCandyScan > CANDY_REFRESH then
                lastCandyScan = now
                cachedCandy = scanCandy(root)
            end

            if cachedCandy then
                setStatus("Collecting candy...")
                safeTeleport(root, cachedCandy.Position + Vector3.new(0, 4, 0), hum)
            else
                if now - lastDoorScan > DOOR_REFRESH then
                    lastDoorScan = now
                    cachedDoor, cachedDoorPart = scanDoor(root)
                end

                if cachedDoor and cachedDoorPart then
                    if now >= promptCooldown then
                        setStatus("Going under tree...")
                        -- chui xuống DƯỚI gốc cây
                        local up = underTreePos(cachedDoorPart)
                        safeTeleport(root, up, hum)
                        task.wait(0.25)
                        pcall(function() fireproximityprompt(cachedDoor) end)
                        promptCooldown = now + 0.8
                    else
                        setStatus("Cooldown...")
                    end
                else
                    setStatus("No candy - hopping early...")
                    hopServer(); return
                end
            end
        end

        task.wait(0.1)
    end
end)

Players.LocalPlayer.OnTeleport:Connect(function(state)
    if state == Enum.TeleportState.Started then
        alive = false
        cleanup()
    end
end)
